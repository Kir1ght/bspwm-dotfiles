#!/usr/bin/env python3
"""Read the battery of a VXE R1 SE+ mouse through its 2.4 GHz dongle.

The receiver (Compx "Nearlink" dongle, 373b:10c9) exposes a vendor HID
collection: usage page 0xFF02, report ID 0x08, 17-byte input and output
reports. There is no feature report, so the exchange is an output report
followed by an input report.

Request:  08 04 00 .. 00 49        (checksum = 0x4D - cmd)
Reply:    08 04 .. percent charging voltage_hi voltage_lo ..

percent is byte 6, charging byte 7, millivolts bytes 8-9 (big endian).
Models that answer a different battery command use 0x17: percent = byte5*2.
Protocol notes: github.com/ivancacic/vxe-battery-tray (PROTOCOL.md).

Usage:
    vxe-battery            "87% (charging)"
    vxe-battery --percent  87
    vxe-battery --json     {"percent":87,"charging":true,"millivolts":4100}
    vxe-battery --udev     print the udev rule that grants access to hidraw
"""

import glob
import json
import os
import select
import sys
import time

VENDOR = "373b"
PRODUCT = "10c9"
REPORT_ID = 0x08
REPORT_LEN = 17

UDEV_RULE = (
    '# VXE R1 SE+ (Compx Nearlink dongle 373b:10c9): let the logged-in user\n'
    '# read the battery over hidraw.\n'
    'SUBSYSTEM=="hidraw", ATTRS{idVendor}=="373b", ATTRS{idProduct}=="10c9", '
    'TAG+="uaccess"\n'
)


def is_battery_iface(name):
    """True if this hidraw node exposes the 0xFF02 / report 8 / 16-byte pair."""
    try:
        with open(f"/sys/class/hidraw/{name}/device/report_descriptor", "rb") as fh:
            desc = fh.read()
    except OSError:
        return False
    return b"\x06\x02\xff" in desc and b"\x85\x08" in desc


def candidates():
    """hidraw nodes belonging to the mouse dongle.

    The dongle exposes three HID interfaces; only one carries the vendor
    battery collection. Picking it from the report descriptor avoids waiting
    for timeouts on the other two.
    """
    hid_id = f":0000{VENDOR.upper()}:0000{PRODUCT.upper()}"
    found = []
    for path in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        name = os.path.basename(path)
        try:
            with open(os.path.join(path, "device", "uevent")) as fh:
                uevent = fh.read()
        except OSError:
            continue
        if hid_id in uevent:
            found.append(name)
    preferred = [name for name in found if is_battery_iface(name)]
    for name in preferred or found:
        yield "/dev/" + name


def query(dev, cmd, timeout=1.0):
    request = bytes([REPORT_ID, cmd] + [0] * 14 + [(0x4D - cmd) & 0xFF])
    deadline = time.monotonic() + timeout
    try:
        # Bound the read; a kernel-side USB write may still take time.
        fd = os.open(dev, os.O_RDWR | os.O_NONBLOCK)
    except PermissionError:
        raise
    except OSError:
        return None
    try:
        _, ready_w, _ = select.select([], [fd], [], timeout)
        if not ready_w:
            return None
        if os.write(fd, request) != len(request):
            return None
        while time.monotonic() < deadline:
            ready, _, _ = select.select([fd], [], [], max(0, deadline - time.monotonic()))
            if not ready:
                break
            reply = os.read(fd, REPORT_LEN)
            if len(reply) == REPORT_LEN and reply[0] == REPORT_ID and reply[1] == cmd:
                return reply
            if not reply:
                break
    except OSError:
        return None
    finally:
        os.close(fd)
    return None


def parse(reply, cmd):
    if cmd == 0x04:
        percent = reply[6]
        charging = reply[7] == 1
        millivolts = (reply[8] << 8) | reply[9]
        if 0 <= percent <= 100 and (millivolts == 0 or 2500 <= millivolts <= 5000):
            return percent, charging, millivolts
        return None
    percent = reply[5] * 2
    if 0 <= percent <= 100:
        return percent, None, None
    return None


def read_battery(budget=2.5):
    """Ask the dongle for the charge, giving up after `budget` seconds.

    polybar polls this from a module script with its own timeout; a sleeping
    mouse must fail fast instead of holding the label hostage.
    """
    deadline = time.monotonic() + budget
    denied = []
    devices = list(candidates())
    if not devices:
        raise FileNotFoundError("mouse receiver is not connected")
    for dev in devices:
        for cmd, attempts in ((0x04, 2), (0x17, 1)):
            # A sleeping mouse often ignores the first report; a second one
            # wakes it. Keep the whole exchange short so a silent mouse cannot
            # stall a polybar poll.
            for attempt in range(attempts):
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    break
                try:
                    reply = query(dev, cmd, timeout=min(0.75, remaining))
                except PermissionError:
                    denied.append(dev)
                    break
                if reply is None:
                    time.sleep(0.05)
                    continue
                parsed = parse(reply, cmd)
                if parsed:
                    return parsed[0], parsed[1], parsed[2], dev
                break
    if denied:
        raise PermissionError(", ".join(sorted(set(denied))))
    return None


def main():
    args = sys.argv[1:]
    if "--udev" in args:
        print(UDEV_RULE, end="")
        return 0
    try:
        result = read_battery()
    except FileNotFoundError as exc:
        print(exc, file=sys.stderr)
        return 3
    except PermissionError as exc:
        print(
            f"no access to {exc}: install the udev rule (`vxe-battery --udev`)\n"
            "or run once as root",
            file=sys.stderr,
        )
        return 2
    if result is None:
        print("no reply: the mouse may be asleep (move it and try again)", file=sys.stderr)
        return 1

    percent, charging, millivolts, dev = result
    if "--json" in args:
        print(json.dumps({"percent": percent, "charging": charging,
                          "millivolts": millivolts, "device": dev}))
    elif "--percent" in args:
        print(percent)
    elif "--verbose" in args:
        extra = []
        if charging is not None:
            extra.append("charging" if charging else "on battery")
        if millivolts:
            extra.append(f"{millivolts / 1000:.2f} V")
        suffix = f" ({', '.join(extra)})" if extra else ""
        print(f"{percent}%{suffix} [{dev}]")
    else:
        extra = []
        if charging:
            extra.append("charging")
        if millivolts:
            extra.append(f"{millivolts / 1000:.2f} V")
        suffix = f" ({', '.join(extra)})" if extra else ""
        print(f"{percent}%{suffix}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
