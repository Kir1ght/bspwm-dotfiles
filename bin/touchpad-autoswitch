#!/usr/bin/env bash
# Toggle for touchpad-when-mouse.sh.
#
#   touchpad-autoswitch on      # auto: touchpad off while a mouse is connected
#   touchpad-autoswitch off     # touchpad always on (automation paused)
#   touchpad-autoswitch toggle  # flip current state
#   touchpad-autoswitch status  # print current state
#
# Bound to Super+Shift+U by default (see config/sxhkd/sxhkdrc).

set -u

XINPUT=/usr/sbin/xinput
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
FLAG="$STATE_DIR/touchpad-when-mouse.off"
DAEMON="$HOME/.local/bin/touchpad-when-mouse.sh"

mkdir -p "$STATE_DIR"

is_off() { [ -f "$FLAG" ]; }

touchpad_ids() {
    "$XINPUT" list --short 2>/dev/null \
        | sed -n 's/^[^A-Za-z0-9]*[[:space:]]*\(.*\)[[:space:]]\+id=\([0-9]\+\).*\[\([^]]*\)\].*/\2\t\1\t\3/p' \
        | awk -F'\t' 'tolower($2) ~ /touchpad/ {print $1}'
}

set_touchpad() {   # $1 = enable|disable
    local id
    for id in $(touchpad_ids); do
        "$XINPUT" "$1" "$id" 2>/dev/null
    done
}

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -t 2000 -i input-touchpad "Touchpad autoswitch" "$1"
}

status() {
    if is_off; then
        echo "off (touchpad always on)"
    else
        echo "on (touchpad disabled while a mouse is connected)"
    fi
}

case "${1:-toggle}" in
    on)
        rm -f "$FLAG"
        notify "Включено: тачпад гаснет при подключённой мыши"
        echo "on"
        ;;
    off)
        : > "$FLAG"
        set_touchpad enable          # мгновенно вернуть тачпад, не ждать демона
        notify "Выключено: тачпад всегда включён"
        echo "off"
        ;;
    toggle)
        if is_off; then
            rm -f "$FLAG"
            notify "Включено: тачпад гаснет при подключённой мыши"
            echo "on"
        else
            : > "$FLAG"
            set_touchpad enable
            notify "Выключено: тачпад всегда включён"
            echo "off"
        fi
        ;;
    status)
        status
        ;;
    *)
        echo "usage: $(basename "$0") {on|off|toggle|status}" >&2
        exit 2
        ;;
esac

# If the daemon is not running (e.g. after manual kill), start it again.
if ! pgrep -f '[/]home/kiri/.local/bin/touchpad-when-mouse.sh' >/dev/null 2>&1 \
   && [ -x "$DAEMON" ]; then
    setsid -f "$DAEMON" >/dev/null 2>&1
fi
