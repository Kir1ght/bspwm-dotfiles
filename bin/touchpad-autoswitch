#!/usr/bin/env bash
# Toggle for touchpad-when-mouse.sh.
#
#   touchpad-autoswitch on      # auto: touchpad off while a mouse is connected
#   touchpad-autoswitch off     # touchpad always on (automation paused)
#   touchpad-autoswitch toggle  # flip current state
#   touchpad-autoswitch status  # print current state
#
# Bound to Super+Shift+U by default (see config/sxhkd/sxhkdrc).

set -u

self=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")
. "$(dirname -- "$self")/touchpad-lib.sh"

STATE_DIR="${TP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}}"
FLAG="$STATE_DIR/touchpad-when-mouse.off"
DAEMON=${TP_DAEMON:-$HOME/.local/bin/touchpad-when-mouse.sh}
[ -x "$DAEMON" ] || DAEMON="$(dirname -- "$self")/touchpad-when-mouse.sh"

mkdir -p "$STATE_DIR"

is_off() { [ -f "$FLAG" ]; }

set_touchpad() {   # enable | disable
    local id
    tp_read_devices
    tp_compute_bases
    while IFS= read -r id; do
        [ -n "$id" ] && "$TP_XINPUT" "$1" "$id" 2>/dev/null
    done < <(tp_ids)
}

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -t 2000 -i input-touchpad "Touchpad autoswitch" "$1"
}

status() {
    if is_off; then
        echo "off (touchpad always on)"
    else
        echo "on (touchpad disabled while a mouse is connected)"
    fi
}

enable_automation() {
    rm -f "$FLAG"
    notify "Enabled: touchpad turns off while a mouse is connected"
    echo "on"
}

disable_automation() {
    : > "$FLAG"
    # Do not wait for the daemon: turn the pad (both interfaces) back on and
    # start gestures right away.
    set_touchpad enable
    tp_gestures on
    notify "Disabled: touchpad stays on"
    echo "off"
}

case "${1:-toggle}" in
    on)
        enable_automation
        ;;
    off)
        disable_automation
        ;;
    toggle)
        if is_off; then
            enable_automation
        else
            disable_automation
        fi
        ;;
    status)
        status
        ;;
    *)
        echo "usage: $(basename "$0") {on|off|toggle|status}" >&2
        exit 2
        ;;
esac

# If the daemon is not running (e.g. after a manual kill), start it again.
# The daemon's flock makes a double start harmless.
if ! pgrep -f '[t]ouchpad-when-mouse\.sh' >/dev/null 2>&1 \
   && [ -x "$DAEMON" ]; then
    setsid -f "$DAEMON" >/dev/null 2>&1
fi
