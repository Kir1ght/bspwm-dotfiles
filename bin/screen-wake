#!/bin/sh
# Bring the panel back when X or DPMS left it dark.
#
# If an X session ends while the display is off (Super+S, DPMS idle, a killed
# session), the framebuffer console often stays black: the requested sysfs
# brightness is unchanged, so the driver never re-applies it to the hardware.
# Writing a different value forces the panel to light up again.
#
# Safe to call at any time: it only touches the backlight when the panel is
# actually dark (actual_brightness near zero) and only clears DPMS from a
# running X session.

for DIR in /sys/class/backlight/*; do
    [ -r "$DIR/max_brightness" ] && break
done
CARD=${DIR##*/}

if read -r MAX 2>/dev/null <"$DIR/max_brightness" &&
   read -r ACTUAL 2>/dev/null <"$DIR/actual_brightness" &&
   [ "$MAX" -gt 0 ] && [ "$ACTUAL" -le "$((MAX / 20))" ]; then
    # systemd-backlight stores a raw value in the selected device's units.
    # Fall back to 30% instead of writing a value only valid on one laptop.
    SAVED=""
    for f in /var/lib/systemd/backlight/*:backlight:"$CARD"; do
        [ ! -r "$f" ] || read -r SAVED _ <"$f"
    done
    if ! [ "${SAVED:-0}" -gt "$((MAX / 20))" ] 2>/dev/null ||
       [ "$SAVED" -gt "$MAX" ] 2>/dev/null; then
        SAVED=$(((MAX * 30 + 99) / 100))
    fi
    printf '%s\n' "$SAVED" 2>/dev/null >"$DIR/brightness" || true
fi

if [ -n "${DISPLAY:-}" ] && command -v xset >/dev/null 2>&1; then
    timeout -k 1 2 xset dpms force on >/dev/null 2>&1 || true
fi
