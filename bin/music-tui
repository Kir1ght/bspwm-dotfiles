#!/usr/bin/env python3
"""music-tui — synchronized lyrics drawn as big block letters.

Run `music-tui` from any terminal. A borderless window opens and shows the
words being sung, one or two at a time, drawn as large white block glyphs in
the style of terminal ASCII art. Nothing else is drawn: no track name, no
hints, no second colour.

Lyrics come from lrclib.net (no account needed) and the position from any MPRIS
player through playerctl, so it follows whatever is playing.
"""

import bisect
import hashlib
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from functools import lru_cache

try:
    from PIL import Image, ImageDraw, ImageFont
except ImportError:
    Image = ImageDraw = ImageFont = None

# Internal marker: set when the script re-launches itself inside the window.
INNER = "MUSIC_TUI_INNER"
FONT_SIZE = 10
CACHE_DIR = os.path.expanduser("~/.cache/music-tui")
USER_AGENT = "music-tui (https://github.com/Kir1ght/bspwm-dotfiles)"

RESET = "\x1b[0m"
CLEAR = "\x1b[H\x1b[2J"
HIDE_CURSOR = "\x1b[?25l"
SHOW_CURSOR = "\x1b[?25h"
# Without this a long line wraps, the frame scrolls and the window looks empty.
NO_WRAP = "\x1b[?7l"
WRAP = "\x1b[?7h"
# The alternate screen has no scrollback, so the mouse wheel cannot drag the
# words off the window and nothing can be left over from an earlier frame.
ALT_ON = "\x1b[?1049h"
ALT_OFF = "\x1b[?1049l"


# --------------------------------------------------------------------------- #
# Art: a real font, reduced to half-block pixels
# --------------------------------------------------------------------------- #
# Latin and Cyrillic look best in the terminal's own ExtraBold. Japanese lyrics
# need a CJK font, otherwise every character is drawn as a tofu box.
FONT_STACK = (
    ("/usr/share/fonts/TTF/JetBrainsMonoNerdFont-ExtraBold.ttf", 0),
    ("/usr/share/fonts/TTF/JetBrainsMono-ExtraBold.ttf", 0),
    ("/usr/share/fonts/noto-cjk/NotoSansCJK-Black.ttc", 0),
)
REF_PX = 110
# Default terminal colours: the theme decides the look.
FOREGROUND = "\x1b[39m"
LEVEL = 105
# A half-block pixel is 1.33 times taller than a cell is wide, so the bitmap
# needs that many more columns to keep the letters in proportion.
PIXEL_ASPECT = 1.33


@lru_cache(maxsize=8)
def font_charset(path, index):
    """Characters a font file can draw, or None when it cannot be read."""
    try:
        from fontTools.ttLib import TTFont
    except ImportError:
        return None
    try:
        font = TTFont(path, fontNumber=index, lazy=True)
        charset = set()
        for table in font["cmap"].tables:
            if table.isUnicode():
                charset.update(table.cmap)
        font.close()
    except (OSError, KeyError, ValueError):
        return None
    return frozenset(charset)


@lru_cache(maxsize=8)
def font_at(path, index):
    """A ready ImageFont at the reference size, or None."""
    if ImageFont is None:
        return None
    try:
        return ImageFont.truetype(path, REF_PX, index=index)
    except (OSError, ValueError):
        return None


def has_fonts():
    """True when at least one font of the stack can be opened."""
    return any(font_at(path, index) for path, index in FONT_STACK)


def typeface(text):
    """(font, text) for a word: the first font that can draw all of it.

    Characters no available font can draw are dropped, so one stray emoji
    cannot turn the whole line into boxes.
    """
    best = None
    best_missing = None
    for path, index in FONT_STACK:
        if not os.path.exists(path):
            continue
        charset = font_charset(path, index)
        font = font_at(path, index)
        if charset is None or font is None:
            continue
        missing = sum(
            1 for ch in text if not ch.isspace() and ord(ch) not in charset
        )
        if missing == 0:
            return font, text
        if best_missing is None or missing < best_missing:
            best, best_missing = (font, charset), missing
    if best is None:
        return None, ""
    font, charset = best
    kept = "".join(ch for ch in text if ch.isspace() or ord(ch) in charset)
    return font, kept


def text_box(font, text):
    """(width, height) of `text` in reference pixels, or None."""
    left, top, right, bottom = font.getbbox(text)
    if right - left <= 0 or bottom - top <= 0:
        return None
    return right - left, bottom - top


@lru_cache(maxsize=64)
def art(text, columns, rows):
    """Terminal rows drawing `text` as big white letters.

    Each cell shows two pixels, so the letters keep their proportions in a cell
    that is twice as tall as it is wide. Nothing is ever clipped: the text is
    scaled down until it fits the window.
    """
    font, clean = typeface(text)
    box = text_box(font, clean) if font is not None else None
    if box is None:
        return []

    src_w, src_h = box
    scale = min(
        columns * 0.94 / (src_w * PIXEL_ASPECT), rows * 2 * 0.86 / src_h
    )
    dst_w = max(1, int(src_w * PIXEL_ASPECT * scale))
    dst_h = max(1, int(src_h * scale))

    left, top, _, _ = font.getbbox(clean)
    canvas = Image.new("L", (src_w, src_h), 0)
    ImageDraw.Draw(canvas).text((-left, -top), clean, fill=255, font=font)
    canvas = canvas.resize((dst_w, dst_h), Image.LANCZOS)
    pixels = canvas.load()

    grid = [[pixels[x, y] > LEVEL for x in range(dst_w)] for y in range(dst_h)]
    while len(grid) % 2:
        grid.append([False] * dst_w)

    pad = max(0, (columns - dst_w) // 2)
    tail = " " * max(0, columns - pad - dst_w)
    lines = []
    for row in range(0, len(grid), 2):
        upper, lower = grid[row], grid[row + 1]
        cells = []
        for x in range(dst_w):
            up, down = upper[x], lower[x]
            if up and down:
                cells.append("\u2588")
            elif up:
                cells.append("\u2580")
            elif down:
                cells.append("\u2584")
            else:
                cells.append(" ")
        lines.append(" " * pad + "".join(cells) + tail)
    return lines


# --------------------------------------------------------------------------- #
# Player
# --------------------------------------------------------------------------- #
FORMAT = "\x1f".join(
    ["{{status}}", "{{artist}}", "{{title}}", "{{mpris:length}}", "{{position}}"]
)


def player_state():
    """Return the current MPRIS state, or None when nothing is playing."""
    try:
        out = subprocess.run(
            ["playerctl", "metadata", "--format", FORMAT],
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    parts = out.stdout.rstrip("\n").split("\x1f")
    if len(parts) < 5:
        return None
    status, artist, title, length, position = parts[:5]
    return {
        "status": status.strip(),
        "artist": artist.strip(),
        "title": title.strip(),
        "duration": micro(length),
        "position": micro(position),
    }


def micro(value):
    try:
        return int(value) / 1_000_000
    except (TypeError, ValueError):
        return 0.0


class Clock:
    """A smooth playback position built from coarse player samples.

    playerctl reports the position only when asked, and some players round it
    to whole seconds, so a sample can jump forwards or backwards. The clock
    counts time itself between samples and only nudges towards a new sample, so
    a word never shows up early and then has to be taken back.
    """

    SAMPLE = 0.5

    def __init__(self):
        self.state = None
        self.position = 0.0
        self.stamp = 0.0
        self.sampled = 0.0

    def read(self):
        now = time.monotonic()
        if self.state is not None and self.state["status"] == "Playing":
            self.position += now - self.stamp
        self.stamp = now

        if self.state is None or now - self.sampled >= self.SAMPLE:
            fresh = player_state()
            self.sampled = now
            if fresh is not None:
                self._correct(fresh)

        if self.state is None:
            return None
        state = dict(self.state)
        state["position"] = self.position
        return state

    def _correct(self, fresh):
        """Pull the estimate towards a fresh sample, never backwards slowly."""
        previous = self.state
        self.state = fresh
        if (
            previous is None
            or previous["title"] != fresh["title"]
            or fresh["status"] != "Playing"
        ):
            self.position = fresh["position"]
            return
        drift = fresh["position"] - self.position
        if drift < -3.0:
            # Only a real jump backwards (a seek) rewinds the position.
            self.position = fresh["position"]
        elif drift > 0:
            # Catch up gently when the player is ahead of us. Later samples
            # are never allowed to pull the words back, so a word cannot show
            # up and then be replaced by the previous one.
            self.position += drift * 0.6


# --------------------------------------------------------------------------- #
# Lyrics
# --------------------------------------------------------------------------- #
def http_json(url):
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.load(response)


def fetch_synced(artist, title):
    """Time-synced lyrics from lrclib.net, cached per track."""
    if not artist or not title:
        return None
    key = hashlib.sha1(f"{artist}\x00{title}".encode()).hexdigest()
    path = os.path.join(CACHE_DIR, key + ".json")
    if os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as fh:
                return json.load(fh).get("synced")
        except (OSError, ValueError):
            pass

    synced = None
    queries = [
        {"artist_name": artist, "track_name": title},
        {"q": f"{artist} {title}"},
    ]
    for params in queries:
        endpoint = "search" if "q" in params else "get"
        url = f"https://lrclib.net/api/{endpoint}?" + urllib.parse.urlencode(params)
        try:
            data = http_json(url)
        except (urllib.error.URLError, ValueError, OSError):
            continue
        if isinstance(data, list):
            for item in data:
                if item.get("syncedLyrics"):
                    synced = item["syncedLyrics"]
                    break
        elif isinstance(data, dict):
            synced = data.get("syncedLyrics")
        if synced:
            break

    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            json.dump({"artist": artist, "title": title, "synced": synced}, fh)
    except OSError:
        pass
    return synced


STAMP = re.compile(r"\[(\d+):(\d+(?:\.\d+)?)\]")


def parse_lrc(text):
    """LRC text -> [(seconds, line)] sorted by time."""
    lines = []
    for raw in text.splitlines():
        stamps = STAMP.findall(raw)
        if not stamps:
            continue
        lyric = STAMP.sub("", raw).strip()
        for minutes, seconds in stamps:
            lines.append((int(minutes) * 60 + float(seconds), lyric))
    lines.sort(key=lambda item: item[0])
    return lines


CJK = re.compile(r"[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]")
CLOSING = "、。，．！？!?…」』）)】〉》"


def chunks(text, size=4):
    """Cut text into groups, keeping closing punctuation on its group."""
    out = []
    start = 0
    while start < len(text):
        end = min(start + size, len(text))
        while end < len(text) and text[end] in CLOSING:
            end += 1
        out.append(text[start:end])
        start = end
    merged = []
    for chunk in out:
        if merged and all(ch in CLOSING for ch in chunk):
            merged[-1] += chunk
        else:
            merged.append(chunk)
    return merged


def line_parts(text):
    """The pieces of a lyric line that are shown one at a time.

    Latin lyrics are already split into words. Japanese and Chinese are written
    without spaces, so those lines are cut into groups of a few characters,
    otherwise a whole line would be one very wide and very small word.
    """
    parts = []
    for part in text.split():
        if len(part) > 5 and CJK.search(part):
            parts.extend(chunks(part))
        else:
            parts.append(part)
    return parts


def word_schedule(lines, duration):
    """[(start, end, word, line)] for the whole song.

    lrclib gives one timestamp per line, so a line's duration is spread over
    its words by length. The span is capped, otherwise a line followed by a
    long instrumental gap would stretch its words and they would appear late.
    """
    words = []
    for index, (start, text) in enumerate(lines):
        if index + 1 < len(lines):
            end = lines[index + 1][0]
        else:
            end = min(start + 6.0, duration or start + 6.0)
        parts = line_parts(text)
        if not parts:
            continue
        span = min(max(0.3, end - start), 0.6 + 0.9 * len(parts))
        weights = [len(part) + 1 for part in parts]
        total = sum(weights)
        moment = start
        for part, weight in zip(parts, weights):
            step = span * weight / total
            words.append((moment, moment + step, part, index))
            moment += step
    return words


PAIR_CHARS = 13


def groups(words):
    """[(start, end, text)] of what is shown at once.

    Two short words are shown together, which reads better than a single word
    flickering by. The grouping is fixed in advance, so the same moment of the
    song always shows the same text: nothing can repeat or appear out of order,
    and seeking backwards just works.

    Each group also carries when it stops being sung, so an instrumental gap
    clears the screen instead of leaving the last word hanging there.
    """
    out = []
    index = 0
    while index < len(words):
        start, end, text, line = words[index]
        if index + 1 < len(words):
            following, next_line = words[index + 1][2], words[index + 1][3]
            if (
                next_line == line
                and not CJK.search(text)
                and len(text) + len(following) + 1 <= PAIR_CHARS
            ):
                out.append((start, words[index + 1][1], text + " " + following))
                index += 2
                continue
        out.append((start, end, text))
        index += 1
    return out


class Lyrics:
    """Lyrics of the current track, loaded in the background.

    A single tuple holds the schedule, so the render loop always sees either
    the whole new song or the whole old one, never a half-written state.
    """

    def __init__(self):
        self.key = None
        self.ready = ((), ())  # (groups, start times)

    def load(self, artist, title, duration):
        """Start fetching when the track changes; never block the render loop."""
        key = (artist, title)
        if key == self.key:
            return
        self.key = key
        self.ready = ((), ())
        threading.Thread(
            target=self._fetch, args=(artist, title, duration), daemon=True
        ).start()

    def _fetch(self, artist, title, duration):
        synced = fetch_synced(artist, title)
        words = word_schedule(parse_lrc(synced), duration) if synced else []
        shown = groups(words)
        if self.key != (artist, title):
            return
        self.ready = (tuple(shown), tuple(item[0] for item in shown))

    def at(self, position):
        """Index of the group being sung, or -1 when nothing is being sung."""
        shown, starts = self.ready
        if not shown:
            return -1
        index = bisect.bisect_right(starts, position) - 1
        if index < 0 or position > shown[index][1]:
            return -1
        return index


# --------------------------------------------------------------------------- #
# Drawing
# --------------------------------------------------------------------------- #
def terminal_size():
    """(rows, columns) of the real terminal, never the environment fallback."""
    for stream in (sys.stdout, sys.stderr, sys.stdin):
        try:
            size = os.get_terminal_size(stream.fileno())
        except (OSError, ValueError, AttributeError):
            continue
        if size.columns > 0 and size.lines > 0:
            return size.lines, size.columns
    return 24, 80


def draw(lines, rows, columns):
    """Draw the art block in the middle of the window.

    Each row is erased before it is written, so a frame can never be mixed with
    what was on screen before: a window that was dragged or resized by the
    compositor comes back clean instead of showing half of two frames.
    """
    top = max(0, (rows - len(lines)) // 2)
    out = [CLEAR, HIDE_CURSOR, FOREGROUND]
    for offset, line in enumerate(lines[:rows]):
        out.append(f"\x1b[{top + offset + 1};1H\x1b[2K")
        out.append(line[:columns] + RESET)
    sys.stdout.write("".join(out))
    sys.stdout.flush()


# --------------------------------------------------------------------------- #
# Main loop
# --------------------------------------------------------------------------- #
def run():
    sys.stdout.write(ALT_ON + HIDE_CURSOR + NO_WRAP + CLEAR)
    sys.stdout.flush()

    if ImageFont is None or not has_fonts():
        sys.stdout.write("python-pillow is needed for the big letters\n")
        sys.stdout.flush()
        time.sleep(4)
        return

    clock = Clock()
    lyrics = Lyrics()
    signature = None
    size = (0, 0)
    painted = 0.0
    # Set on SIGWINCH, so a window that is resized or moved redraws at once
    # instead of waiting for the next word.
    resized = {"flag": True}

    def on_winch(signum, frame):
        resized["flag"] = True

    try:
        signal.signal(signal.SIGWINCH, on_winch)
    except (AttributeError, ValueError):
        pass

    try:
        while True:
            state = clock.read()
            now = time.monotonic()

            if state is None:
                index = -1
                frame = ("idle",)
            else:
                lyrics.load(state["artist"], state["title"], state["duration"])
                index = lyrics.at(state["position"])
                frame = (index, state["title"], state["status"])

            rows, columns = terminal_size()
            if (rows, columns) != size:
                size = (rows, columns)
                resized["flag"] = True

            # Repaint when the words change, when the window was moved or
            # resized, and now and then anyway: a terminal can lose part of its
            # content while a window is dragged, and a stale frame must not be
            # left on screen until the next word happens to be sung.
            if frame != signature or resized["flag"] or now - painted >= 1.0:
                lines = []
                if index >= 0:
                    lines = art(lyrics.ready[0][index][2], columns, rows)
                if not lines:
                    lines = art("♪", columns, rows)
                draw(lines, rows, columns)
                signature = frame
                painted = now
                resized["flag"] = False

            time.sleep(0.05)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write(WRAP + SHOW_CURSOR + RESET + ALT_OFF)
        sys.stdout.flush()


def focus_existing():
    """Bring an already open window forward instead of stacking a second one."""
    try:
        found = subprocess.run(
            ["xdotool", "search", "--class", "^music-tui$"],
            capture_output=True,
            text=True,
            timeout=2,
        ).stdout.split()
        if not found:
            return False
        subprocess.run(
            ["bspc", "node", found[0], "-f"], capture_output=True, timeout=2
        )
        desktop = subprocess.run(
            ["bspc", "query", "-D", "-n", found[0], "--names"],
            capture_output=True,
            text=True,
            timeout=2,
        ).stdout.strip()
        if desktop:
            subprocess.run(
                ["bspc", "desktop", "-f", desktop], capture_output=True, timeout=2
            )
        return True
    except (OSError, subprocess.TimeoutExpired):
        return False


def launch():
    """Open a borderless window and run this script in it."""
    if focus_existing():
        return

    args = [
        "alacritty",
        "-o",
        f"font.size={FONT_SIZE}",
        "-o",
        "window.padding.x=0",
        "-o",
        "window.padding.y=0",
        "-o",
        "window.dynamic_padding=false",
        "-o",
        'window.decorations="none"',
        "--class",
        "music-tui,music-tui",
        "-T",
        "music-tui",
        "-e",
        "env",
        f"{INNER}=1",
        os.path.realpath(__file__),
    ]

    rule = "music-tui:music-tui:*"
    try:
        subprocess.run(["bspc", "rule", "-r", rule], capture_output=True, timeout=2)
        monitor = json.loads(
            subprocess.run(
                ["bspc", "query", "-T", "-m"], capture_output=True, text=True, timeout=2
            ).stdout
        )
        rect, padding = monitor["rectangle"], monitor["padding"]
        x = rect["x"] + padding["left"]
        y = rect["y"] + padding["top"]
        w = rect["width"] - padding["left"] - padding["right"]
        h = rect["height"] - padding["top"] - padding["bottom"]
        win_w, win_h = int(w * 0.68), int(h * 0.32)
        geometry = (
            f"{win_w}x{win_h}+{x + (w - win_w) // 2}+{y + (h - win_h) // 2}"
        )
        subprocess.run(
            [
                "bspc",
                "rule",
                "-a",
                rule,
                "state=floating",
                "border=off",
                f"rectangle={geometry}",
            ],
            capture_output=True,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError):
        pass

    # Detach, so the terminal that ran `music-tui` returns to its prompt at once.
    subprocess.Popen(
        args,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


if __name__ == "__main__":
    if os.environ.get(INNER):
        run()
    else:
        launch()
