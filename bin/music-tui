#!/usr/bin/env python3
"""music-tui — synchronized lyrics, one or two words at a time.

Run `music-tui` from any terminal. It opens a borderless window with a large
font and shows only the words being sung: the active word in the accent colour
and the next one dimmed. Nothing else is drawn.

Lyrics come from lrclib.net (no account needed) and the position from any
MPRIS player through playerctl, so it follows whatever is playing. Colours are
read from the current Alacritty theme, so the window matches the desktop.
"""

import bisect
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

# Internal marker: set when the script re-launches itself inside the window.
INNER = "MUSIC_TUI_INNER"
FONT_SIZE = 64
CACHE_DIR = os.path.expanduser("~/.cache/music-tui")
USER_AGENT = "music-tui (https://github.com/Kir1ght/bspwm-dotfiles)"


# --------------------------------------------------------------------------- #
# Palette
# --------------------------------------------------------------------------- #
def read_palette():
    """Colours of the active terminal theme, with sane fallbacks."""
    palette = {
        "background": "#131719",
        "foreground": "#eceeee",
        "accent": "#70cbeb",
        "dim": "#8f9ea3",
        "faint": "#2e393d",
    }
    path = os.path.expanduser("~/.config/alacritty/theme-colors.toml")
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return palette

    section = ""
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("["):
            section = line.strip("[]").replace("colors.", "")
            continue
        match = re.match(r'(\w+)\s*=\s*"(#[0-9a-fA-F]{6})"', line)
        if not match:
            continue
        name, value = match.group(1), match.group(2)
        if section == "primary":
            if name == "background":
                palette["background"] = value
            elif name == "foreground":
                palette["foreground"] = value
        elif section == "normal" and name == "blue":
            palette["accent"] = value
        elif section == "bright" and name == "black":
            palette["dim"] = value
        elif section == "selection" and name == "background":
            palette["faint"] = value
    return palette


def rgb(color):
    return int(color[1:3], 16), int(color[3:5], 16), int(color[5:7], 16)


def fg(color, bold=False):
    r, g, b = rgb(color)
    return f"\x1b[{'1;' if bold else ''}38;2;{r};{g};{b}m"


def blend(color, other, amount):
    """Mix two hex colours; `amount` is how much of `color` to keep."""
    (r1, g1, b1), (r2, g2, b2) = rgb(color), rgb(other)
    return "#%02x%02x%02x" % (
        round(r1 * amount + r2 * (1 - amount)),
        round(g1 * amount + g2 * (1 - amount)),
        round(b1 * amount + b2 * (1 - amount)),
    )


RESET = "\x1b[0m"
CLEAR = "\x1b[H\x1b[2J"
HIDE_CURSOR = "\x1b[?25l"
SHOW_CURSOR = "\x1b[?25h"
# Without this a long line wraps, the frame scrolls and the window looks empty.
NO_WRAP = "\x1b[?7l"
WRAP = "\x1b[?7h"


# --------------------------------------------------------------------------- #
# Player
# --------------------------------------------------------------------------- #
FORMAT = "\x1f".join(
    ["{{status}}", "{{artist}}", "{{title}}", "{{mpris:length}}", "{{position}}"]
)


def player_state():
    """Return (status, artist, title, duration, position) in seconds."""
    try:
        out = subprocess.run(
            ["playerctl", "metadata", "--format", FORMAT],
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    parts = out.stdout.rstrip("\n").split("\x1f")
    if len(parts) < 5:
        return None
    status, artist, title, length, position = parts[:5]
    return {
        "status": status.strip(),
        "artist": artist.strip(),
        "title": title.strip(),
        "duration": micro(length),
        "position": micro(position),
    }


def micro(value):
    try:
        return int(value) / 1_000_000
    except (TypeError, ValueError):
        return 0.0


# --------------------------------------------------------------------------- #
# Lyrics
# --------------------------------------------------------------------------- #
def http_json(url):
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.load(response)


def fetch_synced(artist, title):
    """Time-synced lyrics from lrclib.net, cached per track."""
    if not artist or not title:
        return None
    key = hashlib.sha1(f"{artist}\x00{title}".encode()).hexdigest()
    path = os.path.join(CACHE_DIR, key + ".json")
    if os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as fh:
                return json.load(fh).get("synced")
        except (OSError, ValueError):
            pass

    synced = None
    queries = [
        {"artist_name": artist, "track_name": title},
        {"q": f"{artist} {title}"},
    ]
    for params in queries:
        endpoint = "search" if "q" in params else "get"
        url = f"https://lrclib.net/api/{endpoint}?" + urllib.parse.urlencode(params)
        try:
            data = http_json(url)
        except (urllib.error.URLError, ValueError, OSError):
            continue
        if isinstance(data, list):
            for item in data:
                if item.get("syncedLyrics"):
                    synced = item["syncedLyrics"]
                    break
        elif isinstance(data, dict):
            synced = data.get("syncedLyrics")
        if synced:
            break

    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            json.dump({"artist": artist, "title": title, "synced": synced}, fh)
    except OSError:
        pass
    return synced


STAMP = re.compile(r"\[(\d+):(\d+(?:\.\d+)?)\]")


def parse_lrc(text):
    """LRC text -> [(seconds, line)] sorted by time."""
    lines = []
    for raw in text.splitlines():
        stamps = STAMP.findall(raw)
        if not stamps:
            continue
        lyric = STAMP.sub("", raw).strip()
        for minutes, seconds in stamps:
            lines.append((int(minutes) * 60 + float(seconds), lyric))
    lines.sort(key=lambda item: item[0])
    return lines


def word_schedule(lines, duration):
    """[(start, end, word)] for the whole song.

    lrclib only gives one timestamp per line, so a line's duration is spread
    over its words by length. Close enough to read along with.
    """
    words = []
    for index, (start, text) in enumerate(lines):
        if index + 1 < len(lines):
            end = lines[index + 1][0]
        else:
            end = min(start + 6.0, duration or start + 6.0)
        parts = text.split()
        if not parts:
            continue
        weights = [len(part) + 1 for part in parts]
        total = sum(weights)
        span = max(0.3, end - start)
        moment = start
        for part, weight in zip(parts, weights):
            step = span * weight / total
            words.append((moment, moment + step, part))
            moment += step
    return words


class Lyrics:
    """Lyrics of the current track, reloaded when the track changes."""

    def __init__(self):
        self.key = None
        self.words = []
        self.starts = []
        self.error = False

    def load(self, artist, title, duration):
        key = (artist, title)
        if key == self.key:
            return
        self.key = key
        self.words = []
        self.starts = []
        self.error = False
        synced = fetch_synced(artist, title)
        if not synced:
            self.error = True
            return
        self.words = word_schedule(parse_lrc(synced), duration)
        self.starts = [word[0] for word in self.words]
        self.error = not self.words

    def at(self, position):
        """Index of the word being sung, or -1 before the first one."""
        if not self.words:
            return -1
        index = bisect.bisect_right(self.starts, position) - 1
        return max(-1, min(index, len(self.words) - 1))


# --------------------------------------------------------------------------- #
# Drawing
# --------------------------------------------------------------------------- #
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def terminal_size():
    """(rows, columns) of the real terminal, never the environment fallback."""
    for stream in (sys.stdout, sys.stderr, sys.stdin):
        try:
            size = os.get_terminal_size(stream.fileno())
        except (OSError, ValueError, AttributeError):
            continue
        if size.columns > 0 and size.lines > 0:
            return size.lines, size.columns
    return 24, 80


def width(text):
    return sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in text)


def clip(text, limit):
    """Cut styled text to at most `limit` columns, keeping escapes valid."""
    tokens = []
    total = 0
    for part in ANSI.split(text):
        if not part:
            continue
        if part.startswith("\x1b"):
            tokens.append((part, 0))
        else:
            tokens.append((part, width(part)))
            total += width(part)
    if total <= limit:
        return text

    out = []
    used = 0
    room = max(0, limit - 1)  # one cell for the ellipsis
    for part, part_width in tokens:
        if part_width == 0:
            out.append(part)
            continue
        if used + part_width <= room:
            out.append(part)
            used += part_width
            continue
        for ch in part:
            step = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
            if used + step > room:
                break
            out.append(ch)
            used += step
        break
    return "".join(out) + "…" + RESET


def centre(text, columns):
    plain = ANSI.sub("", text)
    if width(plain) > columns:
        text = clip(text, columns)
        plain = ANSI.sub("", text)
    pad = max(0, (columns - width(plain)) // 2)
    return " " * pad + text


def draw(palette, rows, columns, top, middle, bottom):
    """Full-frame redraw; only called when the visible word changes.

    Every line is placed at an absolute row and clipped to the width, so a long
    title can never wrap the frame off screen.
    """
    mid = rows // 2
    lines = {mid: middle}
    if top:
        lines[mid - 2] = top
    if bottom:
        lines[mid + 2] = bottom

    out = [CLEAR, HIDE_CURSOR]
    for row in sorted(lines):
        text = lines[row]
        if not text or not 0 <= row < rows:
            continue
        out.append(f"\x1b[{row + 1};1H")
        out.append(centre(text, columns) + "\x1b[K")
    sys.stdout.write("".join(out))
    sys.stdout.flush()


def show_idle(palette, message, detail=""):
    rows, columns = terminal_size()
    draw(
        palette,
        rows,
        columns,
        "",
        fg(palette["dim"]) + message + RESET,
        fg(palette["faint"]) + detail + RESET if detail else "",
    )


# --------------------------------------------------------------------------- #
# Main loop
# --------------------------------------------------------------------------- #
def run():
    palette = read_palette()
    sys.stdout.write(HIDE_CURSOR + NO_WRAP + CLEAR)
    sys.stdout.flush()

    lyrics = Lyrics()
    signature = None
    missing_player = False

    try:
        while True:
            state = player_state()

            if state is None:
                if not missing_player:
                    show_idle(palette, "♪")
                    missing_player = True
                    signature = None
                time.sleep(0.5)
                continue
            missing_player = False

            lyrics.load(state["artist"], state["title"], state["duration"])
            index = lyrics.at(state["position"])

            # Colours derived from the theme: the word being sung is bright, the
            # next one is quiet.
            soon = blend(palette["foreground"], palette["background"], 0.55)

            if lyrics.error or index < 0:
                top = bottom = ""
                middle = fg(soon) + "♪" + RESET
            else:
                current = lyrics.words[index][2]
                following = (
                    lyrics.words[index + 1][2]
                    if index + 1 < len(lyrics.words)
                    else ""
                )
                top = bottom = ""
                middle = fg(palette["accent"], bold=True) + current + RESET
                if following:
                    middle += " " + fg(soon) + following + RESET

            playing = state["status"] == "Playing"
            size = terminal_size()
            frame = (index, state["title"], playing, size)
            if frame != signature:
                rows, columns = size
                if not playing:
                    middle = fg(soon) + ANSI.sub("", middle) + RESET
                draw(palette, rows, columns, top, middle, bottom)
                signature = frame
            time.sleep(0.08)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write(WRAP + SHOW_CURSOR + RESET)
        sys.stdout.flush()


def launch():
    """Open a borderless window with a large font and run this script in it."""
    palette = read_palette()
    args = [
        "alacritty",
        "-o",
        f"font.size={FONT_SIZE}",
        "-o",
        'font.bold.style="ExtraBold"',
        "-o",
        "window.padding.x=0",
        "-o",
        "window.padding.y=0",
        "-o",
        "window.dynamic_padding=false",
        "-o",
        'window.decorations="none"',
        "-o",
        "window.opacity=1.0",
        "-o",
        f'colors.primary.background="{palette["background"]}"',
        "-o",
        f'colors.primary.foreground="{palette["foreground"]}"',
        "--class",
        "music-tui,music-tui",
        "-T",
        "music-tui",
        "-e",
        "env",
        f"{INNER}=1",
        os.path.realpath(__file__),
    ]

    rule = "music-tui:music-tui:*"
    try:
        subprocess.run(["bspc", "rule", "-r", rule], capture_output=True, timeout=2)
        monitor = json.loads(
            subprocess.run(
                ["bspc", "query", "-T", "-m"], capture_output=True, text=True, timeout=2
            ).stdout
        )
        rect, padding = monitor["rectangle"], monitor["padding"]
        x = rect["x"] + padding["left"]
        y = rect["y"] + padding["top"]
        w = rect["width"] - padding["left"] - padding["right"]
        h = rect["height"] - padding["top"] - padding["bottom"]
        win_w, win_h = int(w * 0.68), int(h * 0.26)
        geometry = (
            f"{win_w}x{win_h}+{x + (w - win_w) // 2}+{y + (h - win_h) // 2}"
        )
        subprocess.run(
            [
                "bspc",
                "rule",
                "-a",
                rule,
                "state=floating",
                "border=off",
                f"rectangle={geometry}",
            ],
            capture_output=True,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError):
        pass

    # Detach, so the terminal that ran `music-tui` returns to its prompt at once.
    subprocess.Popen(
        args,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


if __name__ == "__main__":
    if os.environ.get(INNER):
        run()
    else:
        launch()
