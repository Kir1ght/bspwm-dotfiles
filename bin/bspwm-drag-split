#!/usr/bin/env bash
# Niri-style split placement for bspwm (mouse and touchpad).
#
# Bound to Super + Alt + left mouse button (see config/sxhkd/sxhkdrc).
# Plain Super + mouse keeps the stock bspwm behaviour:
#
#   Super + left drag    move a floating window, swap two tiled windows
#   Super + middle drag  resize a tiled window by the shared split border
#   Super + right drag   resize a tiled window by the nearest corner
#
# With the extra Alt modifier:
#
#   drag  a window onto a half of another window — the half under the cursor
#         is highlighted and, on release, the dragged window is inserted
#         there instead of the two windows swapping places;
#   click a window to mark it, then click a half of another window to place
#         it there (no dragging needed, which is much easier on a touchpad);
#         click the marked window again to unmark it.
#
# Only tiled and pseudo-tiled windows can be split; floating windows are
# moved with plain Super+drag. A floating or pseudo-tiled source becomes a
# normal tile when it is placed, so its old floating/pseudo size is dropped.
# Floating and fullscreen windows are never used as targets, and fullscreen
# sources are ignored. A missing neighbour is not a problem: the target is
# whatever is under the cursor.
#
# The same result is available from the keyboard through bspwm-split:
# Super+Alt+M (mark) -> Super+Alt+H/J/K/L (place in that half).

set -u

BSPC=${BSPC:-$(dirname -- "$0")/bspwmctl}
POLL=${POLL:-0.04}
DRAG_THRESHOLD=${DRAG_THRESHOLD:-9}   # pixels before a click becomes a drag

say() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a bspwm-drag -t 1400 "$1" "${2:-}" >/dev/null 2>&1 || true
}

pointer_ids() {
    xinput list --short 2>/dev/null \
        | sed -n 's/.*id=\([0-9]\+\).*\[slave *pointer.*/\1/p'
}

# Button state of the device that started the drag. Checking every pointer on
# every poll would spawn too many processes; once one device reports a pressed
# button, only that device is polled until it is released.
down_device=""

button1_down() {
    local id
    if [ -n "$down_device" ]; then
        xinput --query-state "$down_device" 2>/dev/null \
            | grep -q 'button\[1\]=down'
        return
    fi
    for id in $(pointer_ids); do
        if xinput --query-state "$id" 2>/dev/null \
            | grep -q 'button\[1\]=down'; then
            down_device=$id
            return 0
        fi
    done
    return 1
}

pointer_xy() {
    local key value px="" py=""
    while IFS='=' read -r key value; do
        case "$key" in
            X) px=$value ;;
            Y) py=$value ;;
        esac
    done < <(xdotool getmouselocation --shell 2>/dev/null)
    [ -n "$px" ] && [ -n "$py" ] || return 1
    printf '%s %s\n' "$px" "$py"
}

node_state() {
    "$BSPC" query -T -n "$1" 2>/dev/null \
        | sed -n 's/.*"state":"\([^"]*\)".*/\1/p' | head -n1
}

node_rect() {
    "$BSPC" query -T -n "$1" 2>/dev/null \
        | sed -n 's/.*"rectangle":{"x":\(-\{0,1\}[0-9]*\),"y":\(-\{0,1\}[0-9]*\),"width":\([0-9]*\),"height":\([0-9]*\)}.*/\1 \2 \3 \4/p' \
        | head -n1
}

node_exists() {
    "$BSPC" query -T -n "$1" >/dev/null 2>&1
}

is_tiled_state() {
    case "${1:-}" in
        tiled|pseudo_tiled) return 0 ;;
    esac
    return 1
}

desktop_layout_of_node() {
    local d
    d=$("$BSPC" query -D -n "$1" 2>/dev/null) || return 1
    "$BSPC" query -T -d "$d" 2>/dev/null \
        | grep -o '"layout":"[^"]*"' | head -n1 | cut -d'"' -f4
}

# Which half of node $1 is closest to screen coordinates $2 $3 (west/east/
# north/south). Prints nothing when the node geometry cannot be read.
half_at() {
    local node=$1 px=$2 py=$3 gx gy gw gh cx cy ax ay abx aby
    read -r gx gy gw gh <<<"$(node_rect "$node")"
    [ -n "${gw:-}" ] && [ "${gw:-0}" -gt 0 ] && [ "${gh:-0}" -gt 0 ] || return 0
    cx=$((px - gx))
    cy=$((py - gy))
    # Compare the horizontal and vertical offsets by cross-multiplying, so no
    # floating point math is needed.
    ax=$(((2 * cx - gw) * gh))
    ay=$(((2 * cy - gh) * gw))
    abx=${ax#-}
    aby=${ay#-}
    if [ "$abx" -ge "$aby" ]; then
        if [ "$ax" -lt 0 ]; then echo west; else echo east; fi
    else
        if [ "$ay" -lt 0 ]; then echo north; else echo south; fi
    fi
}

target=""
dir=""

clear_presel() {
    if [ -n "${target:-}" ]; then
        "$BSPC" node "$target" -p cancel >/dev/null 2>&1 || true
    fi
    target=""
    dir=""
}

# Cancel our own preselection if the script is interrupted mid-drag.
cleanup() {
    clear_presel
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# Move $1 into the $3 half of $2. Re-checks both nodes, because a window may
# have been closed or moved while the pointer was held down.
place_into() {
    local src=$1 tgt=$2 half=$3
    node_exists "$src" || return 1
    node_exists "$tgt" || return 1
    is_tiled_state "$(node_state "$tgt")" || return 1

    # A floating/pseudo-tiled source would keep its old geometry; converting
    # it to a normal tile is what makes the split visible. bspwm exits with
    # status 1 when the node is already tiled, which is not an error.
    "$BSPC" node "$src" -t tiled >/dev/null 2>&1 || true
    if "$BSPC" node "$tgt" -p "$half" >/dev/null 2>&1 \
       && "$BSPC" node "$src" -n "$tgt" >/dev/null 2>&1; then
        "$BSPC" node "$src" -g marked=off >/dev/null 2>&1 || true
        return 0
    fi
    "$BSPC" node "$tgt" -p cancel >/dev/null 2>&1 || true
    return 1
}

say_placed() {
    local half=$1 node=${2:-} l=""
    [ -n "$node" ] && l=$(desktop_layout_of_node "$node")
    if [ "$l" = monocle ]; then
        say "Window placed" "Leave monocle to see the split"
    else
        say "Window placed" "Split into the $half half"
    fi
}

command -v "$BSPC" >/dev/null 2>&1 || exit 0
command -v xdotool >/dev/null 2>&1 || exit 0
command -v xinput >/dev/null 2>&1 || exit 0

start=$("$BSPC" query -N -n pointed 2>/dev/null) || exit 0
[ -n "$start" ] || exit 0

state=$(node_state "$start")
# Receptacles and other non-client nodes are left alone.
[ -n "$state" ] || exit 0
# Fullscreen windows cover everything and are not a split candidate.
[ "$state" = "fullscreen" ] && exit 0

start_pos=$(pointer_xy) || exit 0
read -r start_x start_y <<<"$start_pos"

moved=0
last_node=""
last_state=""

while button1_down; do
    if ! pos=$(pointer_xy); then
        sleep "$POLL"
        continue
    fi
    read -r px py <<<"$pos"

    if [ "$moved" -eq 0 ]; then
        dx=$((px - start_x))
        dy=$((py - start_y))
        if [ $((dx * dx + dy * dy)) -gt $((DRAG_THRESHOLD * DRAG_THRESHOLD)) ]; then
            moved=1
        fi
    fi

    if [ "$moved" -eq 1 ]; then
        current=$("$BSPC" query -N -n pointed 2>/dev/null)
        if [ -z "$current" ] || [ "$current" = "$start" ]; then
            clear_presel
            last_node=""
        else
            # Cache the state of the window under the cursor: it changes only
            # when the cursor crosses a window boundary.
            if [ "$current" != "$last_node" ]; then
                last_state=$(node_state "$current")
                last_node=$current
            fi
            if is_tiled_state "$last_state"; then
                half=$(half_at "$current" "$px" "$py")
                if [ -n "$half" ]; then
                    if [ "$current" != "$target" ] || [ "$half" != "$dir" ]; then
                        clear_presel
                        if "$BSPC" node "$current" -p "$half" >/dev/null 2>&1; then
                            target=$current
                            dir=$half
                        fi
                    fi
                else
                    clear_presel
                fi
            else
                clear_presel
            fi
        fi
    fi

    sleep "$POLL"
done

pos=$(pointer_xy) || pos="$start_pos"
read -r end_x end_y <<<"$pos"

# A very fast drag can end before the first poll. The button is already up, so
# rebuild the target from the release point instead of treating it as a click.
if [ "$moved" -eq 0 ]; then
    dx=$((end_x - start_x))
    dy=$((end_y - start_y))
    if [ $((dx * dx + dy * dy)) -gt $((DRAG_THRESHOLD * DRAG_THRESHOLD)) ]; then
        current=$("$BSPC" query -N -n pointed 2>/dev/null)
        if [ -n "$current" ] && [ "$current" != "$start" ] \
           && is_tiled_state "$(node_state "$current")"; then
            half=$(half_at "$current" "$end_x" "$end_y")
            if [ -n "$half" ] && place_into "$start" "$current" "$half"; then
                say_placed "$half" "$current"
            fi
        fi
        exit 0
    fi
fi

# A click without movement: mark the window, or drop the marked window into
# the clicked half (much easier than dragging on a touchpad).
if [ "$moved" -eq 0 ]; then
    marked_all=$("$BSPC" query -N -n .marked 2>/dev/null)

    # Clicking the marked window itself removes the mark.
    if printf '%s\n' "$marked_all" | grep -qx "$start"; then
        "$BSPC" node "$start" -g marked=off >/dev/null 2>&1 || true
        say "Mark removed" "Nothing will be moved"
        exit 0
    fi

    marked=$(printf '%s\n' "$marked_all" | head -n1)
    if [ -n "$marked" ]; then
        if ! is_tiled_state "$state"; then
            say "Cannot split this window" "Click a tiled window to place the marked one"
            exit 0
        fi
        half=$(half_at "$start" "$end_x" "$end_y")
        if [ -n "$half" ] && place_into "$marked" "$start" "$half"; then
            say_placed "$half" "$start"
        else
            say "Could not place the window" "Try another half or press Super+Alt+C"
        fi
        exit 0
    fi

    # Only one window can be marked at a time: a stale mark on another window
    # would otherwise win over the window the user just clicked.
    for m in $marked_all; do
        "$BSPC" node "$m" -g marked=off >/dev/null 2>&1 || true
    done
    if "$BSPC" node "$start" -g marked >/dev/null 2>&1; then
        say "Window marked" "Super+Alt+click a half of another window"
    fi
    exit 0
fi

[ -n "$target" ] || exit 0

if place_into "$start" "$target" "$dir"; then
    say_placed "$dir" "$target"
else
    clear_presel
fi
