#!/bin/bash

# Color variables
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color (reset)

# Path to the external hard drive (without trailing slash)
# TODO: change this path to your own backup drive
DEST="/run/media/$USER/aaa"

# CHECK: is the drive mounted?
if [ ! -d "$DEST" ]; then
    echo -e "${RED}ERROR: Drive not found at $DEST. Backup cancelled.${NC}"
    exit 1
fi

echo -e "${BLUE}=== Starting backup to $DEST ===${NC}"

# rsync commands
echo "Syncing Knowledge..."
rsync -av --delete "$HOME/Downloads/Knowledge/" "$DEST/Knowledge/"

echo "Syncing SYNC..."
rsync -av --delete "$HOME/Downloads/SYNC/" "$DEST/SYNC/"

# Write the date
echo "last update: $(date +'%Y-%m-%d %H:%M:%S')" >> "$DEST/update.txt"

echo -e "${GREEN}✔ Done! Data synchronized successfully.${NC}"
