#!/usr/bin/env bash
# Switch the panel refresh rate on AC/battery transitions.
#
# Event source is UPower (`upower -m`), the standard desktop abstraction for
# power-supply state; no polling of /sys. `--apply` is idempotent and is also
# safe to call by hand:
#
#   ~/bin/refresh-auto --apply
#
# The monitor is started from bspwmrc because xrandr needs the X session
# environment (DISPLAY/XAUTHORITY), which a systemd user unit does not inherit.

set -euo pipefail

POLL_FALLBACK=5

log() {
    printf 'refresh-auto: %s\n' "$*" >&2
    command -v logger >/dev/null 2>&1 && logger -t refresh-auto -- "$*" || true
}

output_name() {
    local name
    name=$(xrandr --query 2>/dev/null | awk '/ primary/{print $1; exit}')
    if [[ -n "$name" ]]; then
        printf '%s\n' "$name"
        return 0
    fi
    xrandr --query 2>/dev/null | awk '/ connected/{print $1; exit}'
}

# Rates reported for the mode currently marked active on the output.
rates_of_active_mode() {
    xrandr --query 2>/dev/null | awk -v out="$1" '
        $1 == out { inside = 1; next }
        inside && /^[^ \t]/ { exit }
        inside && /\*/ {
            for (i = 2; i <= NF; i++) {
                if ($i ~ /^[0-9]+\.[0-9]+/) {
                    value = $i
                    gsub(/[*+]/, "", value)
                    print value
                }
            }
            exit
        }
    '
}

current_mode() {
    xrandr --query 2>/dev/null | awk -v out="$1" '
        $1 == out { inside = 1; next }
        inside && /^[^ \t]/ { exit }
        inside && /\*/ {
            for (i = 2; i <= NF; i++) {
                if ($i ~ /\*/) {
                    print $1
                    exit
                }
            }
            exit
        }
    '
}

current_rate() {
    xrandr --query 2>/dev/null | awk -v out="$1" '
        $1 == out { inside = 1; next }
        inside && /\*/ {
            for (i = 2; i <= NF; i++) {
                if ($i ~ /\*/) {
                    value = $i
                    gsub(/[*+]/, "", value)
                    print value
                    exit
                }
            }
            exit
        }
        inside && /^[^ ]/ { exit }
    '
}

on_ac() {
    local state
    for state in /sys/class/power_supply/AC*/online; do
        [[ -r "$state" ]] || continue
        [[ "$(cat "$state" 2>/dev/null)" == "1" ]] && return 0
    done
    return 1
}

apply_locked() {
    local out rates want have mode
    out=$(output_name)
    [[ -n "$out" ]] || return 0

    rates=$(rates_of_active_mode "$out")
    # A single rate means there is nothing to choose from.
    [[ -n "$rates" ]] || return 0
    [[ "$(printf '%s\n' "$rates" | wc -l)" -gt 1 ]] || return 0

    if on_ac; then
        want=$(printf '%s\n' "$rates" | sort -rn | head -n1)
    else
        want=$(printf '%s\n' "$rates" | sort -n | head -n1)
    fi
    have=$(current_rate "$out")
    mode=$(current_mode "$out")

    if [[ -n "$want" && "$have" != "$want" && -n "$mode" ]]; then
        if xrandr --output "$out" --mode "$mode" --rate "$want" >/dev/null 2>&1; then
            log "$out: ${have:-?} Hz -> ${want} Hz ($(on_ac && echo AC || echo battery))"
        else
            log "$out: failed to switch to ${want} Hz"
        fi
    fi
}

apply_once() {
    # Same lock as hz-toggle: read-modify-write on xrandr must be serialised.
    (
        exec 8>"${XDG_RUNTIME_DIR:-/tmp}/xrandr.lock"
        flock -w 5 8 || exit 0
        apply_locked
    )
}

monitor() {
    local lock="${XDG_RUNTIME_DIR:-/tmp}/refresh-auto.lock"
    exec 9>"$lock"
    # A second instance (e.g. bspwmrc re-run) must not fight over xrandr.
    if ! flock -n 9; then
        log "monitor already running"
        return 0
    fi

    # Reconnect if upower is restarted; each iteration is a blocking pipe,
    # not a poll of the hardware.
    while :; do
        if ! upower -m 2>/dev/null | while IFS= read -r line; do
            case "$line" in
                *line_power*) apply_once ;;
            esac
        done; then
            sleep "$POLL_FALLBACK"
        fi
        sleep "$POLL_FALLBACK"
    done
}

case "${1:---apply}" in
    --apply) apply_once ;;
    --monitor)
        apply_once
        monitor
        ;;
    *)
        printf 'usage: %s [--apply|--monitor]\n' "${0##*/}" >&2
        exit 2
        ;;
esac