#!/usr/bin/env python3
"""Stream backlight changes; stop udev monitoring when the bar goes away."""
import os
import select
import signal
import subprocess
import sys
from pathlib import Path


def run() -> int:
    card = os.environ.get("BACKLIGHT_CARD")
    base = Path("/sys/class/backlight")
    devices = [base / card] if card else sorted(base.iterdir())
    backlight = next((path for path in devices if (path / "brightness").is_file()), None)
    if backlight is None:
        return 0

    # Poll the write end for ERR/HUP as well as the udev pipe: a killed bar
    # must not leave an orphan waiting for a backlight change forever.
    output = sys.stdout.fileno()
    poll = select.poll()
    poll.register(output, select.POLLERR | select.POLLHUP)
    monitor = subprocess.Popen(
        ["udevadm", "monitor", "--udev", "--subsystem-match=backlight"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    last = None
    try:
        events = monitor.stdout.fileno()
        poll.register(events, select.POLLIN | select.POLLHUP)
        while True:
            try:
                value = int((backlight / "brightness").read_text())
                maximum = int((backlight / "max_brightness").read_text())
                percent = (value * 100 + maximum // 2) // maximum
            except (OSError, ValueError, ZeroDivisionError):
                print(flush=True)
                return 0
            if percent != last:
                print(f"{percent}%", flush=True)
                last = percent
            ready = dict(poll.poll())
            if output in ready or not os.read(events, 4096):
                return 0
    finally:
        monitor.terminate()
        try:
            monitor.wait(timeout=1)
        except subprocess.TimeoutExpired:
            monitor.kill()
            monitor.wait()


def stop(_signal, _frame):
    raise SystemExit(0)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    try:
        raise SystemExit(run())
    except (OSError, KeyboardInterrupt):
        raise SystemExit(0)
