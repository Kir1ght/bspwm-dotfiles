#!/bin/sh
# Switch the discrete NVIDIA GPU between "usable by X" and "off".
#
# The HDMI port is wired to the NVIDIA GPU, so the X server must load the
# NVIDIA driver for an external monitor to work at all (Reverse PRIME). The
# price: while X holds the dGPU it cannot runtime-suspend, which costs battery.
#
#   hdmi-gpu on       let X load the NVIDIA driver (HDMI works)
#   hdmi-gpu off      X uses only the AMD iGPU (best battery)
#   hdmi-gpu status   show the current state
#
# The change takes effect at the next X login. A missing override is normal.

CONF=/etc/X11/xorg.conf.d/10-igpu.conf
DISABLED=$CONF.disabled

resume_hint() {
    echo "Applies at the next X login; the current session was not changed."
}

case "${1:-status}" in
    status)
        if [ -e "$CONF" ]; then
            echo "Next X login: iGPU-only override present"
        else
            echo "Next X login: NVIDIA allowed (no iGPU-only override)"
        fi
        if ! providers=$(timeout -k 1 3 xrandr --listproviders 2>/dev/null); then
            echo "Current X: unavailable"
        elif printf '%s\n' "$providers" | grep -qi 'NVIDIA'; then
            echo "Current X: NVIDIA provider present; use 'hdmi status' to check the cable"
        else
            echo "Current X: no NVIDIA provider"
        fi
        ;;

    on)
        if [ ! -e "$CONF" ]; then
            echo "NVIDIA is already allowed. Use 'hdmi-gpu status' to check the running X."
            exit 0
        fi
        if [ -e "$DISABLED" ] || [ -L "$DISABLED" ]; then
            echo "Both $CONF and $DISABLED exist; refusing to overwrite either." >&2
            exit 1
        fi
        sudo mv -- "$CONF" "$DISABLED" || exit 1
        resume_hint
        ;;

    off)
        if [ -e "$CONF" ]; then
            echo "already off"
            exit 0
        fi
        if [ -f "$DISABLED" ]; then
            sudo mv -- "$DISABLED" "$CONF" || exit 1
            resume_hint
            exit 0
        fi
        template="${HDMI_GPU_TEMPLATE:-$HOME/bspwm-dotfiles/system/xorg/10-igpu.conf}"
        if [ -r "$template" ]; then
            sudo install -Dm644 "$template" "$CONF" || exit 1
        else
            sudo tee "$CONF" >/dev/null <<'EOF' || exit 1
Section "OutputClass"
    Identifier "igpu only"
    MatchDriver "amdgpu"
    Driver "modesetting"
EndSection

Section "ServerFlags"
    Option "AutoAddGPU" "false"
EndSection
EOF
        fi
        resume_hint
        ;;

    *)
        echo "usage: hdmi-gpu on|off|status" >&2
        exit 2
        ;;
esac
