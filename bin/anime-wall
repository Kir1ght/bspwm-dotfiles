# What Enter does in the result grid: apply (set as wallpaper) or save.
on_enter = save
preview_workers = 16

# Gelbooru wants an account API key and user id.
# https://gelbooru.com/index.php?page=account&s=options
[gelbooru]
api_key =
user_id =

# Only needed for gold-only Danbooru content.
[danbooru]
login =
api_key =
"""


class BooruError(RuntimeError):
    """An error that is safe to show to the user."""


# --------------------------------------------------------------------------
# Paths and configuration
# --------------------------------------------------------------------------


def config_home() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def cache_home() -> Path:
    return Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))


def config_path() -> Path:
    return config_home() / "anime-wall" / "config.ini"


def cache_dir() -> Path:
    path = cache_home() / "anime-wall"
    path.mkdir(parents=True, exist_ok=True)
    return path


def load_config(path: Path | None = None) -> configparser.ConfigParser:
    """Read the ini file, filling in defaults when it does not exist yet."""
    path = path or config_path()
    parser = configparser.ConfigParser(interpolation=None)
    parser.optionxform = str
    parser.read_string(DEFAULT_CONFIG)
    try:
        parser.read(path, encoding="utf-8")
    except OSError as exc:
        raise BooruError(f"cannot read {path}: {exc}") from exc
    return parser


def save_config(parser: configparser.ConfigParser, path: Path | None = None) -> None:
    path = path or config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".ini.tmp")
    with tmp.open("w", encoding="utf-8") as handle:
        parser.write(handle)
    os.chmod(tmp, 0o600)
    tmp.replace(path)
    os.chmod(path, 0o600)


def state_file() -> Path:
    return cache_dir() / "state.json"


def load_state() -> dict:
    try:
        return json.loads(state_file().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    try:
        state_file().write_text(json.dumps(state, indent=2), encoding="utf-8")
    except OSError:
        pass


def expand(path: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(path)))


# --------------------------------------------------------------------------
# Settings
# --------------------------------------------------------------------------


@dataclass
class Settings:
    provider: str = "yandere"
    tags: str = ""
    rating: str = "safe"
    min_score: int = 0
    min_width: int = 1920
    min_height: int = 1080
    orientation: str = "any"
    sort: str = "score"
    per_page: int = 24
    page: int = 1
    on_enter: str = "save"
    download_dir: Path = field(
        default_factory=lambda: Path.home() / "Pictures" / "kiri-vault"
    )
    preview_workers: int = 16

    @classmethod
    def from_config(cls, parser: configparser.ConfigParser) -> "Settings":
        section = parser["general"]

        def number(name: str, fallback: int) -> int:
            try:
                return int(section.get(name, fallback))
            except (TypeError, ValueError):
                return fallback

        provider = section.get("default_provider", "yandere").strip().lower()
        if provider not in PROVIDERS:
            provider = "yandere"

        rating = section.get("rating", "safe").strip().lower()
        if rating not in RATING_CHOICES:
            rating = "safe"

        orientation = section.get("orientation", "any").strip().lower()
        if orientation not in ORIENTATION_CHOICES:
            orientation = "any"

        sort = section.get("sort", "score").strip().lower()
        if sort not in SORT_CHOICES:
            sort = "score"

        on_enter = section.get("on_enter", "save").strip().lower()
        if on_enter not in ON_ENTER_CHOICES:
            on_enter = "save"

        download_dir = expand(
            section.get("download_dir", "~/Pictures/kiri-vault")
        )
        return cls(
            provider=provider,
            rating=rating,
            min_score=number("min_score", 0),
            min_width=number("min_width", 1920),
            min_height=number("min_height", 1080),
            orientation=orientation,
            sort=sort,
            per_page=max(1, min(number("per_page", 24), 200)),
            on_enter=on_enter,
            download_dir=download_dir,
            preview_workers=max(1, min(number("preview_workers", 16), 32)),
        )

    def clamp(self) -> None:
        if self.provider not in PROVIDERS:
            self.provider = "yandere"
        if self.rating not in RATING_CHOICES:
            self.rating = "safe"
        if self.orientation not in ORIENTATION_CHOICES:
            self.orientation = "any"
        if self.sort not in SORT_CHOICES:
            self.sort = "score"
        if self.on_enter not in ON_ENTER_CHOICES:
            self.on_enter = "save"
        self.per_page = max(1, min(self.per_page, PROVIDERS[self.provider]["max_limit"]))
        self.page = max(1, self.page)


def persist_settings(settings: Settings, parser: configparser.ConfigParser) -> None:
    """Remember filter changes so the next launch starts where the user left."""
    if not parser.has_section("general"):
        parser.add_section("general")
    section = parser["general"]
    section["default_provider"] = settings.provider
    section["rating"] = settings.rating
    section["min_score"] = str(settings.min_score)
    section["min_width"] = str(settings.min_width)
    section["min_height"] = str(settings.min_height)
    section["orientation"] = settings.orientation
    section["sort"] = settings.sort
    section["per_page"] = str(settings.per_page)
    section["on_enter"] = settings.on_enter
    try:
        save_config(parser)
    except OSError:
        pass


# --------------------------------------------------------------------------
# API access
# --------------------------------------------------------------------------


@dataclass
class Post:
    provider: str
    id: int
    file_url: str
    preview_url: str
    width: int
    height: int
    score: int
    rating: str
    tags: str
    file_size: int = 0
    created_at: int = 0
    site: str = ""

    @property
    def page_url(self) -> str:
        if self.provider == "gelbooru":
            return f"{self.site}/index.php?page=post&s=view&id={self.id}"
        return f"{self.site}/post/show/{self.id}"

    @property
    def aspect(self) -> str:
        if not self.width or not self.height:
            return "any"
        ratio = self.width / self.height
        if 0.95 <= ratio <= 1.05:
            return "square"
        return "landscape" if ratio > 1 else "portrait"

    def normalized_rating(self) -> str:
        raw = (self.rating or "").lower()
        if raw in {"s", "safe", "g", "general"}:
            return "safe"
        if raw in {"q", "questionable"}:
            return "questionable"
        if raw in {"e", "explicit"}:
            return "explicit"
        if raw == "sensitive":
            return "safe"
        return "unknown"

    def label(self) -> str:
        size = f"{self.width}×{self.height}" if self.width and self.height else "?×?"
        return f"{size}   ★{self.score}"


def http_json(
    url: str, params: dict, headers: dict | None = None, timeout: int = API_TIMEOUT
) -> object:
    query = urllib.parse.urlencode(params)
    full = f"{url}?{query}" if query else url
    request_headers = {"User-Agent": USER_AGENT, "Accept": "application/json"}
    if headers:
        request_headers.update(headers)
    request = urllib.request.Request(full, headers=request_headers)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = response.read()
    except urllib.error.HTTPError as exc:
        body = exc.read()
        snippet = body[:400].decode("utf-8", "replace")
        if exc.code == 401:
            raise BooruError(
                "Gelbooru needs an API key and user id. "
                "Open the browser menu → “Gelbooru credentials” or fill "
                "~/.config/anime-wall/config.ini."
            ) from exc
        if exc.code == 403 and "Just a moment" in snippet:
            raise BooruError(
                "Cloudflare blocked the API request. Open the site once in "
                "Firefox, then try again; Danbooru often requires JS."
            ) from exc
        if exc.code == 429:
            raise BooruError("Rate limited by the booru. Wait a minute and retry.") from exc
        if exc.code == 503 and "Downbooru" in snippet:
            raise BooruError("Danbooru is down right now (503 Downbooru).") from exc
        raise BooruError(f"HTTP {exc.code} from {urllib.parse.urlparse(url).netloc}") from exc
    except urllib.error.URLError as exc:
        raise BooruError(f"network error: {exc.reason}") from exc
    try:
        return json.loads(body)
    except ValueError as exc:
        snippet = body[:200].decode("utf-8", "replace")
        raise BooruError(f"the booru returned non-JSON data: {snippet!r}") from exc


def api_cache_key(settings: Settings) -> str:
    payload = {
        "provider": settings.provider,
        "tags": settings.tags.strip(),
        "rating": settings.rating,
        "min_score": settings.min_score,
        "min_width": settings.min_width,
        "min_height": settings.min_height,
        "orientation": settings.orientation,
        "sort": settings.sort,
        "per_page": settings.per_page,
        "page": settings.page,
    }
    raw = json.dumps(payload, sort_keys=True, ensure_ascii=False).encode()
    return hashlib.sha1(raw).hexdigest()[:20]


def api_cache_path(key: str) -> Path:
    folder = cache_dir() / "api"
    folder.mkdir(parents=True, exist_ok=True)
    return folder / f"{key}.json"


def read_api_cache(key: str) -> tuple[list, float] | None:
    path = api_cache_path(key)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
        items = payload.get("items")
        stamp = float(payload.get("ts") or 0)
    except (OSError, ValueError, TypeError, AttributeError):
        return None
    if not isinstance(items, list):
        return None
    return items, stamp


def cached_raw_count(settings: Settings) -> int:
    """How many posts the API returned for the current page, before local
    filters. Pagination must follow this number: filtering can leave fewer
    than `per_page` items on screen even when a next page exists."""
    cached = read_api_cache(api_cache_key(settings))
    if cached is None:
        return 0
    items = cached[0]
    return len(items) if isinstance(items, list) else 0


def write_api_cache(key: str, items: list) -> None:
    path = api_cache_path(key)
    tmp = path.with_suffix(f".{os.getpid()}.tmp")
    try:
        tmp.write_text(
            json.dumps({"ts": time.time(), "items": items}, ensure_ascii=False),
            encoding="utf-8",
        )
        tmp.replace(path)
    except OSError:
        tmp.unlink(missing_ok=True)


TAG_CACHE_TTL = 60 * 60 * 6
TAG_SUGGESTION_LIMIT = 12


def tag_cache_path(provider: str, prefix: str) -> Path:
    folder = cache_dir() / "tags"
    folder.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha1(f"{provider}:{prefix}".encode()).hexdigest()[:16]
    return folder / f"{key}.json"


def read_tag_cache(provider: str, prefix: str) -> tuple[list[tuple[str, int]], float] | None:
    path = tag_cache_path(provider, prefix)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
        raw = payload.get("items")
        stamp = float(payload.get("ts") or 0)
    except (OSError, ValueError, TypeError, AttributeError):
        return None
    if not isinstance(raw, list):
        return None
    items: list[tuple[str, int]] = []
    for entry in raw:
        if not (isinstance(entry, list) and len(entry) == 2):
            continue
        name, count = entry
        if isinstance(name, str) and name:
            try:
                items.append((name, int(count)))
            except (TypeError, ValueError):
                continue
    return items, stamp


def write_tag_cache(provider: str, prefix: str, items: list[tuple[str, int]]) -> None:
    path = tag_cache_path(provider, prefix)
    tmp = path.with_suffix(f".{os.getpid()}.tmp")
    try:
        tmp.write_text(
            json.dumps(
                {"ts": time.time(), "items": [[name, count] for name, count in items]},
                ensure_ascii=False,
            ),
            encoding="utf-8",
        )
        tmp.replace(path)
    except OSError:
        tmp.unlink(missing_ok=True)


def fetch_tag_suggestions(
    settings: Settings,
    parser: configparser.ConfigParser | None,
    prefix: str,
    limit: int = TAG_SUGGESTION_LIMIT,
) -> list[tuple[str, int]]:
    """Tags starting with `prefix` and their global post counts.

    Yande.re/Konachan use Moebooru's /tag.json, Danbooru uses /tags.json and
    Gelbooru its autocomplete endpoint. Results are cached for a few hours so
    Tab feels instant after the first lookup.
    """
    provider = settings.provider
    prefix = prefix.strip().lower()
    cached = read_tag_cache(provider, prefix)
    if cached is not None and time.time() - cached[1] < TAG_CACHE_TTL:
        return cached[0][:limit]

    meta = PROVIDERS[provider]
    site = meta["site"]
    items: list[tuple[str, int]] = []

    if provider in ("yandere", "konachan"):
        params: dict[str, object] = {"limit": limit, "order": "count"}
        if prefix:
            params["name"] = prefix
        data = http_json(f"{site}/tag.json", params, timeout=4)
        raw = data if isinstance(data, list) else []
        for entry in raw:
            if isinstance(entry, dict) and entry.get("name"):
                items.append((str(entry["name"]), int(entry.get("count") or 0)))
    elif provider == "danbooru":
        params = {
            "search[name_matches]": f"{prefix}*",
            "search[order]": "count",
            "search[hide_empty]": "true",
            "limit": limit,
        }
        data = http_json(f"{site}/tags.json", params, timeout=4)
        raw = data if isinstance(data, list) else []
        for entry in raw:
            if isinstance(entry, dict) and entry.get("name"):
                items.append(
                    (str(entry["name"]), int(entry.get("post_count") or 0))
                )
    else:  # gelbooru
        params = {"page": "autocomplete2", "term": prefix, "limit": limit}
        if parser is not None:
            api_key = parser.get("gelbooru", "api_key", fallback="").strip()
            user_id = parser.get("gelbooru", "user_id", fallback="").strip()
            if api_key and user_id:
                params["api_key"] = api_key
                params["user_id"] = user_id
        data = http_json(f"{site}/index.php", params, timeout=4)
        raw = data if isinstance(data, list) else []
        for entry in raw:
            if not isinstance(entry, dict):
                continue
            name = entry.get("label") or entry.get("value") or entry.get("name")
            if not name:
                continue
            count = entry.get("post_count") or entry.get("count") or 0
            try:
                items.append((str(name), int(count)))
            except (TypeError, ValueError):
                items.append((str(name), 0))

    seen: set[str] = set()
    unique: list[tuple[str, int]] = []
    for name, count in items:
        if name in seen:
            continue
        seen.add(name)
        unique.append((name, count))
    unique = unique[:limit]
    if unique:
        write_tag_cache(provider, prefix, unique)
    return unique


def tag_prefix(text: str) -> str:
    """The unfinished tag at the cursor end of the search line."""
    if not text or text[-1].isspace():
        return ""
    return text.rstrip().split()[-1]


def tag_suggestions(
    settings: Settings,
    parser: configparser.ConfigParser | None,
    prefix: str,
    text: str,
) -> str | None:
    """Show matching tags with post counts and splice the chosen one in."""
    debug(f"tag hints prefix={prefix!r}")
    try:
        items = fetch_tag_suggestions(settings, parser, prefix)
    except BooruError as exc:
        debug(f"tag hints failed: {exc}")
        notify("Tag hints", str(exc), 5000)
        return None
    if not items:
        debug("tag hints empty")
        hint = f"No tags start with “{prefix}”" if prefix else "No tags returned"
        notify("Tag hints", hint, 2400)
        return None
    debug(f"tag hints {len(items)} matches")

    labels: list[str] = []
    names: dict[str, str] = {}
    for name, count in items:
        label = f"{name}   ·   {count:,} posts"
        labels.append(label)
        names[label] = name
    picked = rofi_menu(
        labels,
        f"Tags · {prefix}" if prefix else "Popular tags",
        width=640,
        lines_visible=min(TAG_SUGGESTION_LIMIT, len(labels)),
    )
    if picked is None:
        return None
    chosen = names.get(picked)
    if not chosen:
        return None
    tokens = text.split()
    if tokens and not text[-1:].isspace() and prefix:
        tokens[-1] = chosen
    else:
        tokens.append(chosen)
    return " ".join(tokens) + " "


def extract_raw(data: object) -> list:
    if isinstance(data, dict):
        raw = data.get("post") or []
    elif isinstance(data, list):
        raw = data
    else:
        raw = []
    return raw if isinstance(raw, list) else []


def build_posts(
    raw: list, provider: str, site: str, settings: Settings
) -> list[Post]:
    posts: list[Post] = []
    for item in raw:
        post = normalize(item, provider, site)
        if post and passes_filters(post, settings):
            posts.append(post)
    sort_posts(posts, settings.sort)
    return posts


def fetch_posts(
    settings: Settings,
    parser: configparser.ConfigParser,
    *,
    use_cache: bool = True,
    quiet: bool = False,
) -> list[Post]:
    settings.clamp()
    provider = settings.provider
    meta = PROVIDERS[provider]

    url = meta["url"]
    site = meta["site"]
    if provider == "konachan" and settings.rating != "safe":
        url = meta.get("url_all", url)
        site = meta.get("site_all", site)

    key = api_cache_key(settings)
    cached = read_api_cache(key)
    if use_cache and cached is not None and time.time() - cached[1] <= API_CACHE_TTL:
        return build_posts(cached[0], provider, site, settings)

    tags = settings.tags.strip()
    rating_tag = meta["ratings"].get(settings.rating)
    if rating_tag and settings.rating != "all":
        tags = f"{tags} {rating_tag}".strip()

    params: dict[str, object] = {
        "tags": tags,
        "limit": min(settings.per_page, meta["max_limit"]),
        meta["page_param"]: meta["page_start"] + settings.page - 1,
    }
    headers: dict[str, str] = {}
    if provider == "gelbooru":
        api_key = parser.get("gelbooru", "api_key", fallback="").strip()
        user_id = parser.get("gelbooru", "user_id", fallback="").strip()
        if not api_key or not user_id:
            if cached is not None:
                if not quiet:
                    notify(
                        "anime-wall",
                        "Gelbooru: no API keys — showing saved results",
                        3000,
                    )
                return build_posts(cached[0], provider, site, settings)
            raise BooruError(
                "Gelbooru needs an API key and user id. "
                "Open the browser menu → “Gelbooru credentials”."
            )
        params.update(
            {
                "page": "dapi",
                "s": "post",
                "q": "index",
                "json": "1",
                "api_key": api_key,
                "user_id": user_id,
            }
        )
    elif provider == "danbooru":
        login = parser.get("danbooru", "login", fallback="").strip()
        api_key = parser.get("danbooru", "api_key", fallback="").strip()
        if login and api_key:
            import base64

            token = base64.b64encode(f"{login}:{api_key}".encode()).decode()
            headers["Authorization"] = f"Basic {token}"

    try:
        data = http_json(url, params, headers)
    except BooruError:
        if cached is not None:
            if not quiet:
                notify(
                    "anime-wall",
                    "Server is unreachable — showing cached results",
                    3000,
                )
            return build_posts(cached[0], provider, site, settings)
        raise

    raw = extract_raw(data)
    write_api_cache(key, raw)
    return build_posts(raw, provider, site, settings)


def normalize(item: dict, provider: str, site: str) -> Post | None:
    if not isinstance(item, dict):
        return None
    file_url = (
        item.get("file_url")
        or item.get("large_file_url")
        or ""
    )
    preview_url = (
        item.get("preview_url")
        or item.get("preview_file_url")
        or item.get("sample_url")
        or item.get("large_file_url")
        or file_url
    )
    if not file_url or not preview_url:
        return None
    if urllib.parse.urlparse(file_url).scheme not in {"http", "https"}:
        return None
    extension = Path(urllib.parse.urlparse(file_url).path).suffix.lower()
    if extension and extension not in IMAGE_EXTENSIONS:
        return None

    width = item.get("width") or item.get("image_width") or 0
    height = item.get("height") or item.get("image_height") or 0
    tags = item.get("tags") or item.get("tag_string") or ""
    try:
        post_id = int(item.get("id"))
    except (TypeError, ValueError):
        return None
    try:
        score = int(item.get("score") or 0)
    except (TypeError, ValueError):
        score = 0
    try:
        file_size = int(item.get("file_size") or 0)
    except (TypeError, ValueError):
        file_size = 0
    try:
        created_at = int(item.get("created_at") or 0)
    except (TypeError, ValueError):
        created_at = 0

    return Post(
        provider=provider,
        id=post_id,
        file_url=file_url,
        preview_url=preview_url,
        width=int(width or 0),
        height=int(height or 0),
        score=score,
        rating=str(item.get("rating") or ""),
        tags=tags,
        file_size=file_size,
        created_at=created_at,
        site=site,
    )


def passes_filters(post: Post, settings: Settings) -> bool:
    if settings.rating != "all":
        rating = post.normalized_rating()
        if rating != "unknown" and rating != settings.rating:
            return False
    if post.score < settings.min_score:
        return False
    if settings.min_width and post.width and post.width < settings.min_width:
        return False
    if settings.min_height and post.height and post.height < settings.min_height:
        return False
    if settings.orientation != "any" and post.aspect != settings.orientation:
        return False
    return True


def sort_posts(posts: list[Post], mode: str) -> None:
    if mode == "new":
        posts.sort(key=lambda post: (post.created_at, post.id), reverse=True)
    elif mode == "random":
        import random

        random.shuffle(posts)
    else:
        posts.sort(key=lambda post: (post.score, post.id), reverse=True)


# --------------------------------------------------------------------------
# Downloading
# --------------------------------------------------------------------------


def safe_name(post: Post) -> str:
    extension = Path(urllib.parse.urlparse(post.file_url).path).suffix.lower()
    if extension not in IMAGE_EXTENSIONS:
        extension = ".jpg"
    return f"{post.provider}_{post.id}{extension}"


def provider_folder(root: Path, provider: str) -> Path:
    """Store each booru in its own full-name folder inside Pictures."""
    label = PROVIDERS.get(provider, {}).get("label", provider.title())
    return root / label


def looks_like_image(data: bytes) -> bool:
    if data.startswith(IMAGE_MAGIC):
        return True
    return data[:4] == b"RIFF" and data[8:12] == b"WEBP"


def valid_image_file(path: Path, size: int = 16) -> bool:
    try:
        if path.stat().st_size <= 0:
            return False
        with path.open("rb") as handle:
            return looks_like_image(handle.read(size))
    except OSError:
        return False


def download(post: Post, folder: Path) -> Path:
    folder.mkdir(parents=True, exist_ok=True)
    target = folder / safe_name(post)
    lock = target.with_suffix(target.suffix + ".lock")
    try:
        with lock.open("a") as lock_handle:
            fcntl.flock(lock_handle, fcntl.LOCK_EX)
            if target.exists() and target.stat().st_size > 0:
                return target

            request = urllib.request.Request(
                post.file_url,
                headers={
                    "User-Agent": USER_AGENT,
                    "Referer": post.site + "/",
                    "Accept": "image/avif,image/webp,image/*,*/*;q=0.8",
                },
            )
            tmp = target.with_suffix(target.suffix + ".part")
            try:
                with urllib.request.urlopen(
                    request, timeout=DOWNLOAD_TIMEOUT
                ) as response, tmp.open("wb") as handle:
                    shutil.copyfileobj(response, handle, length=1024 * 256)
            except urllib.error.HTTPError as exc:
                tmp.unlink(missing_ok=True)
                raise BooruError(f"download failed: HTTP {exc.code}") from exc
            except urllib.error.URLError as exc:
                tmp.unlink(missing_ok=True)
                raise BooruError(f"download failed: {exc.reason}") from exc
            except (OSError, TimeoutError) as exc:
                tmp.unlink(missing_ok=True)
                raise BooruError(f"download failed: {exc}") from exc
            if not valid_image_file(tmp):
                tmp.unlink(missing_ok=True)
                raise BooruError("download failed: server returned a non-image")
            tmp.replace(target)
            return target
    finally:
        lock.unlink(missing_ok=True)


def notify(title: str, body: str, timeout: int = 2500) -> None:
    if not shutil.which("notify-send"):
        return
    try:
        subprocess.run(
            ["notify-send", "-a", "anime-wall", "-t", str(timeout), title, body],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=4,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def debug(message: str) -> None:
    """Opt-in tracing: ANIME_WALL_DEBUG=1 anime-wall"""
    if os.environ.get("ANIME_WALL_DEBUG"):
        print(f"[anime-wall] {message}", file=sys.stderr, flush=True)


def wallpaper_apply_command() -> list[str] | None:
    candidates = [
        Path.home() / "bin" / "random_wallpaper",
        Path.home() / ".local" / "bin" / "random_wallpaper",
    ]
    for candidate in candidates:
        if os.access(candidate, os.X_OK):
            return [str(candidate)]
    found = shutil.which("random_wallpaper")
    return [found] if found else None


def apply_wallpaper(path: Path) -> None:
    command = wallpaper_apply_command()
    if command:
        result = subprocess.run(command + ["--set", str(path)], check=False)
        if result.returncode == 0:
            return
    feh = shutil.which("feh")
    if feh:
        subprocess.run([feh, "--no-fehbg", "--bg-fill", str(path)], check=False)
        return
    raise BooruError("neither random_wallpaper nor feh is installed")


def wallpaper_folder() -> Path:
    """The desktop wallpaper library scanned by random_wallpaper."""
    return Path.home() / "Images" / "Wallpaper_desktop"


def archive_wallpaper(source: Path) -> Path:
    """Copy an applied artwork into the desktop wallpaper library.

    Without this, an image applied from Anime Wall lived only in
    ~/Pictures/kiri-vault, so it could not be found again with the wallpaper
    picker. A file with the same name and content is reused; a different file
    with the same name gets a -2, -3 … suffix instead of being overwritten.
    """
    folder = wallpaper_folder()
    try:
        folder.mkdir(parents=True, exist_ok=True)
        if source.resolve().parent == folder.resolve():
            return source
    except OSError:
        return source

    target = folder / source.name
    counter = 2
    while target.exists():
        try:
            if target.stat().st_size == source.stat().st_size and filecmp.cmp(
                source, target, shallow=False
            ):
                return target
        except OSError:
            pass
        target = folder / f"{source.stem}-{counter}{source.suffix}"
        counter += 1

    tmp = folder / f".{target.name}.{os.getpid()}.tmp"
    try:
        shutil.copy2(source, tmp)
        os.replace(tmp, target)
    except OSError:
        tmp.unlink(missing_ok=True)
        return source
    return target


# --------------------------------------------------------------------------
# Rofi UI
# --------------------------------------------------------------------------


def rofi_binary() -> str:
    found = shutil.which("rofi")
    if not found:
        raise BooruError("rofi is not installed")
    return found


def clean_rofi_pid() -> None:
    """Remove a stale rofi pid file left behind by a killed instance.

    rofi normally does this itself, but a dirty build or a hard kill can leave
    the file behind and make the next launch look like it did nothing.
    """
    runtime = Path(
        os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    )
    pidfile = runtime / "rofi.pid"
    try:
        pid = int(pidfile.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return
    try:
        os.kill(pid, 0)
    except OSError:
        pidfile.unlink(missing_ok=True)


# rofi 2.x on X11 needs a settling period after each invocation. 250 ms is
# enough for the old window to disappear, while keeping page flips snappy.
_ROFI_COOLDOWN = 0.25


def rofi_cooldown() -> None:
    """Give X11 time to release the pointer/keyboard grab."""
    time.sleep(_ROFI_COOLDOWN)


def screen_size() -> tuple[int, int]:
    try:
        out = subprocess.check_output(
            ["xdotool", "getdisplaygeometry"],
            text=True,
            timeout=2,
            stderr=subprocess.DEVNULL,
        )
        width, height = out.split()
        return int(width), int(height)
    except (OSError, ValueError, subprocess.SubprocessError):
        return 1920, 1080


def rofi_theme_args() -> list[str]:
    # rofi always reads ~/.config/rofi/config.rasi, which imports the generated
    # palette (theme.rasi). Passing -theme here would replace that import and
    # leave @bg-col/@blue undefined.
    return []


