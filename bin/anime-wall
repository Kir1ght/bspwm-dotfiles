#!/usr/bin/env python3
"""anime-wall — anime art browser for bspwm.

Search Yande.re, Konachan, Danbooru and Gelbooru from rofi, preview the
results as a thumbnail grid, then save the picture you like or apply it as
the wallpaper through random_wallpaper (which also rebuilds the palette).

The downloader is deliberately self contained: only the Python standard
library is used for HTTP, so the package list does not grow. Preview images
are cached in ~/.cache/anime-wall, full images go to
~/Pictures/kiri-vault/<Provider>/ by default.

Usage:
    anime-wall                          open the rofi browser
    anime-wall --print                  print the results as JSON
    anime-wall --download 5             download the first five results
    anime-wall -p konachan -t landscape print Konachan results
"""

from __future__ import annotations

import argparse
import configparser
import concurrent.futures
import fcntl
import filecmp
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import asdict, dataclass, field
from pathlib import Path

USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/122.0 Safari/537.36"
)
IMAGE_EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp"}
IMAGE_MAGIC = (b"\xff\xd8\xff", b"\x89PNG\r\n\x1a\n", b"GIF87a", b"GIF89a")

# Keep every network operation short and bounded. A dead booru must never make
# the rofi menu feel like it froze.
API_TIMEOUT = 7
PREVIEW_TIMEOUT = 3
PREVIEW_BUDGET = 2.5
DOWNLOAD_TIMEOUT = 120
API_CACHE_TTL = 300
PREVIEW_CACHE_TTL = 60 * 60 * 24 * 30

RATING_CHOICES = ("safe", "questionable", "explicit", "all")
ORIENTATION_CHOICES = ("any", "landscape", "portrait", "square")
SORT_CHOICES = ("score", "new", "random")
ON_ENTER_CHOICES = ("apply", "save")

PROVIDERS = {
    "yandere": {
        "label": "Yande.re",
        "url": "https://yande.re/post.json",
        "site": "https://yande.re",
        "page_param": "page",
        "page_start": 1,
        "max_limit": 100,
        "ratings": {
            "safe": "rating:safe",
            "questionable": "rating:questionable",
            "explicit": "rating:explicit",
        },
    },
    "konachan": {
        "label": "Konachan",
        "url": "https://konachan.net/post.json",
        "url_all": "https://konachan.com/post.json",
        "site": "https://konachan.net",
        "site_all": "https://konachan.com",
        "page_param": "page",
        "page_start": 1,
        "max_limit": 100,
        "ratings": {
            "safe": "rating:safe",
            "questionable": "rating:questionable",
            "explicit": "rating:explicit",
        },
    },
    "danbooru": {
        "label": "Danbooru",
        "url": "https://danbooru.donmai.us/posts.json",
        "site": "https://danbooru.donmai.us",
        "page_param": "page",
        "page_start": 1,
        "max_limit": 200,
        "ratings": {
            "safe": "rating:g",
            "questionable": "rating:q",
            "explicit": "rating:e",
        },
    },
    "gelbooru": {
        "label": "Gelbooru",
        "url": "https://gelbooru.com/index.php",
        "site": "https://gelbooru.com",
        "page_param": "pid",
        "page_start": 0,
        "max_limit": 100,
        "ratings": {
            "safe": "rating:general",
            "questionable": "rating:questionable",
            "explicit": "rating:explicit",
        },
    },
}

DEFAULT_CONFIG = """\
# anime-wall settings. Keep this file private: it may contain API keys.
[general]
download_dir = ~/Pictures/kiri-vault
default_provider = yandere
per_page = 24
rating = safe
