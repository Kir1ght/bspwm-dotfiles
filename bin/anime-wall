FALLBACK_COLORS = [
    ("@border-col", "#9081da"),
    ("@bg-col-light", "#312e3d"),
    ("@selected-col", "#312e3d"),
    ("@fg-col2", "#c28cd9"),
    ("@bg-col", "#141319"),
    ("@fg-col", "#ececee"),
    ("@blue", "#9081da"),
    ("@grey", "#928fa3"),
]


def themed_args(theme_str: str) -> list[str]:
    args = rofi_theme_args()
    if not (config_home() / "rofi" / "theme.rasi").is_file():
        for name, value in FALLBACK_COLORS:
            theme_str = theme_str.replace(name, value)
    return args + ["-theme-str", theme_str]


def rofi_menu(lines: list[str], prompt: str, *, width: int = 700, lines_visible: int = 10) -> str | None:
    if not lines:
        return None
    clean_rofi_pid()
    screen_w, screen_h = screen_size()
    width = min(width, max(420, screen_w - 80))
    lines_visible = max(1, min(lines_visible, max(3, (screen_h - 160) // 42)))
    text = "\n".join(lines) + "\n"
    theme = MENU_THEME.replace("lines: 10;", f"lines: {lines_visible};")
    theme = theme.replace("width: 820px;", f"width: {width}px;")
    menu_height = min(100 + lines_visible * 42, screen_h - 100)
    theme = theme.replace("height: 520px;", f"height: {menu_height}px;")
    command = [
        rofi_binary(),
        "-dmenu",
        "-i",
        "-no-history",
        "-no-custom",
        "-p",
        prompt,
    ]
    command += themed_args(theme)
    try:
        result = subprocess.run(
            command,
            input=text.encode(),
            stdout=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        raise BooruError(f"cannot start rofi: {exc}") from exc
    if result.returncode != 0:
        rofi_cooldown()
        return None
    rofi_cooldown()
    return result.stdout.decode("utf-8", "replace").strip() or None


def rofi_text(prompt: str, initial: str = "") -> str | None:
    """Free-text prompt. The previous value is offered as a selectable line."""
    clean_rofi_pid()
    lines = [initial] if initial else []
    text = "\n".join(lines) + ("\n" if lines else "")
    theme = MENU_THEME.replace("height: 520px;", "height: 140px;")
    theme = theme.replace("lines: 10;", "lines: 1;")
    command = [
        rofi_binary(),
        "-dmenu",
        "-i",
        "-no-history",
        "-p",
        prompt,
    ] + themed_args(theme)
    try:
        result = subprocess.run(
            command,
            input=text.encode(),
            stdout=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        raise BooruError(f"cannot start rofi: {exc}") from exc
    if result.returncode != 0:
        rofi_cooldown()
        return None
    rofi_cooldown()
    return result.stdout.decode("utf-8", "replace").strip()


def rofi_error(message: str) -> None:
    notify("anime-wall", message, 6000)


def preview_path(post: Post) -> Path:
    folder = cache_dir() / "previews"
    folder.mkdir(parents=True, exist_ok=True)
    return folder / f"{post.provider}_{post.id}.img"


def placeholder_preview() -> Path | None:
    """A calm grey thumbnail for posts whose preview has not arrived yet."""
    folder = cache_dir() / "previews"
    target = folder / "_placeholder.png"
    if valid_image_file(target):
        return target
    try:
        from PIL import Image, ImageDraw
    except ImportError:
        return None
    folder.mkdir(parents=True, exist_ok=True)
    size = 320
    image = Image.new("RGB", (size, size), "#24222e")
    draw = ImageDraw.Draw(image)
    draw.rounded_rectangle(
        (28, 28, size - 28, size - 28),
        radius=18,
        outline="#4a4658",
        width=4,
    )
    # Tiny landscape glyph: sun + two hills.
    draw.ellipse((196, 80, 250, 134), fill="#8a7fb0")
    draw.polygon(
        [(44, 250), (132, 150), (196, 214), (246, 164), (278, 250)],
        fill="#38344a",
    )
    tmp = target.with_suffix(f".{os.getpid()}.tmp")
    try:
        image.save(tmp, format="PNG")
        tmp.replace(target)
    except OSError:
        tmp.unlink(missing_ok=True)
        return None
    return target


def download_preview(post: Post) -> Path | None:
    target = preview_path(post)
    if valid_image_file(target):
        return target
    if target.exists():
        target.unlink(missing_ok=True)
    request = urllib.request.Request(
        post.preview_url,
        headers={
            "User-Agent": USER_AGENT,
            "Referer": post.site + "/",
            "Accept": "image/avif,image/webp,image/*,*/*;q=0.8",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=PREVIEW_TIMEOUT) as response:
            data = response.read(6 * 1024 * 1024 + 1)
    except (urllib.error.URLError, OSError, TimeoutError):
        return None
    if not data or len(data) > 6 * 1024 * 1024 or not looks_like_image(data):
        return None
    tmp = target.with_suffix(f".{os.getpid()}.tmp")
    try:
        tmp.write_bytes(data)
        tmp.replace(target)
    except OSError:
        tmp.unlink(missing_ok=True)
        return None
    return target


def spawn_preview_prefetch(posts: list[Post]) -> None:
    if not posts:
        return
    try:
        payload = json.dumps([asdict(post) for post in posts], ensure_ascii=False)
        subprocess.Popen(
            [
                sys.executable,
                str(Path(__file__).resolve()),
                "--prefetch-previews",
                payload,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except (OSError, ValueError):
        pass


def fetch_previews(
    posts: list[Post],
    workers: int,
    *,
    budget: float = PREVIEW_BUDGET,
    spawn: bool = True,
) -> dict[int, Path]:
    """Return whatever previews are ready within a short, hard budget.

    Cached thumbnails are picked up instantly. Missing ones are fetched in
    parallel; after `budget` seconds we stop waiting and show the grid with the
    thumbnails that arrived, while a detached process fills the cache for the
    next open.
    """
    previews: dict[int, Path] = {}
    pending: list[Post] = []
    for post in posts:
        target = preview_path(post)
        if valid_image_file(target):
            previews[post.id] = target
        else:
            pending.append(post)
    if not pending:
        return previews

    pool = concurrent.futures.ThreadPoolExecutor(max_workers=max(1, workers))
    futures = {pool.submit(download_preview, post): post for post in pending}
    done, _ = concurrent.futures.wait(futures, timeout=budget)
    for future in done:
        post = futures[future]
        try:
            path = future.result()
        except Exception:
            path = None
        if path is not None:
            previews[post.id] = path
    pool.shutdown(wait=False, cancel_futures=True)
    if spawn and len(previews) < len(posts):
        spawn_preview_prefetch([post for post in posts if post.id not in previews])
    return previews


def refresh_previews(posts: list[Post], previews: dict[int, Path]) -> None:
    """Pick up thumbnails the background worker finished while the grid was
    open, so reopening it after a save upgrades placeholders without a wait."""
    for post in posts:
        if post.id in previews:
            continue
        target = preview_path(post)
        if valid_image_file(target):
            previews[post.id] = target


def build_entries(
    posts: list[Post],
    previews: dict[int, Path],
    download_root: Path,
    pending_ids: set[int] | None = None,
) -> bytes:
    pending_ids = pending_ids or set()
    placeholder = placeholder_preview()
    chunks: list[bytes] = []
    for post in posts:
        label = post.label()
        target = provider_folder(download_root, post.provider) / safe_name(post)
        if post.id in pending_ids or target.exists():
            label = "✓ " + label
        line = label.encode()
        icon = previews.get(post.id) or placeholder
        if icon:
            line += b"\0icon\x1f" + str(icon).encode()
        chunks.append(line + b"\n")
    return b"".join(chunks)


def grid_index(result: subprocess.CompletedProcess, count: int) -> int | None:
    raw = result.stdout.decode("utf-8", "replace").strip()
    if raw.isdigit():
        index = int(raw)
        if 0 <= index < count:
            return index
    return None


# Thumbnail grid metrics. The numbers mirror GRID_THEME: element padding,
# listview spacing and one text line below the icon. Keeping them in one place
# lets the window shrink to the cells it shows on any monitor. Rofi adds a few
# hidden pixels to every row, so GRID_ROW_EXTRA is deliberately generous: a
# slightly short window silently hides the last row.
GRID_ICON_MIN = 120
GRID_ICON_MAX = 420
GRID_ELEMENT_PAD = 8
GRID_CELL_GAP = 12
GRID_ROW_EXTRA = 65
GRID_CHROME = 136


def grid_layout(count: int) -> tuple[int, int, int, int, int]:
    """Scale the grid to the screen.

    Rofi fills a multi-column dmenu top-to-bottom, so the layout is chosen by
    row count: ``columns = ceil(count / rows)``. That keeps the window width
    equal to the columns actually drawn (no empty strip on the right) and
    guarantees no item is left out. Returns
    ``(width, height, columns, lines, icon)``.
    """
    screen_w, screen_h = screen_size()
    max_w = max(560, screen_w - 120)
    max_h = max(360, screen_h - 40)
    icon_cap = int(min(GRID_ICON_MAX, max(GRID_ICON_MIN + 60, screen_h * 0.20)))
    cell_extra_w = 2 * GRID_ELEMENT_PAD + GRID_CELL_GAP

    best: tuple[float, int, int, int] | None = None
    # Never stack fewer than ~4 items per row: a five-result page should be a
    # wide banner, not one tall column of giant thumbnails.
    rows_cap = max(1, min(8, (count + 3) // 4))
    for rows in range(1, rows_cap + 1):
        columns = (count + rows - 1) // rows
        if columns > 9:
            continue
        icon_w = (max_w - 16) / columns - cell_extra_w
        if icon_w < GRID_ICON_MIN:
            continue
        icon_h = (max_h - GRID_CHROME - 8) / rows - GRID_ROW_EXTRA
        icon = int(min(icon_w, icon_h, icon_cap))
        if icon < GRID_ICON_MIN:
            icon = GRID_ICON_MIN
        cell_w = icon + cell_extra_w
        row_h = icon + GRID_ROW_EXTRA
        lines = max(1, min(rows, (max_h - GRID_CHROME - 8) // row_h))
        width = min(max_w, max(720, columns * cell_w + 16))
        height = min(max_h, GRID_CHROME + lines * row_h + 8)
        fill = (width / max_w) * (height / max_h)
        # A completely filled grid looks tidier: prefer row counts where every
        # column is full (24 results -> 6x4 rather than 5x5 with a gap).
        slots = rows * columns
        ragged = (slots - count) / slots if slots else 0.0
        # Keep the grid from becoming one huge row or a single tall column.
        aspect = (columns * cell_w) / (lines * row_h)
        score = fill - 0.06 * ragged - 0.04 * abs(aspect - 1.6)
        if best is None or score > best[0]:
            best = (score, columns, lines, icon)

    if best is None:
        rows = max(1, min(4, count))
        columns = (count + rows - 1) // rows
        icon = GRID_ICON_MIN
        cell_w = icon + cell_extra_w
        row_h = icon + GRID_ROW_EXTRA
        return (
            min(max_w, max(720, columns * cell_w + 16)),
            min(max_h, GRID_CHROME + rows * row_h + 8),
            columns,
            rows,
            icon,
        )

    _, columns, lines, icon = best
    cell_w = icon + cell_extra_w
    row_h = icon + GRID_ROW_EXTRA
    width = min(max_w, max(720, columns * cell_w + 16))
    height = min(max_h, GRID_CHROME + lines * row_h + 8)
    return width, height, columns, lines, icon


def run_grid(
    entries: bytes,
    prompt: str,
    count: int,
    has_next: bool,
    on_enter: str,
    selected_row: int = 0,
    has_prev: bool = False,
) -> tuple[str, int | None]:
    """Run the thumbnail grid.

    Returns ("pick"|"save"|"apply"|"next"|"prev"|"page"|"quit"|"cancel",
    index). All actions are plain rofi custom keys, so the window reacts
    immediately: Enter follows the configured action, Alt+S saves only,
    Alt+A applies, Alt+B/Alt+N change pages, Alt+G picks a page by number.
    `selected_row` keeps the user's place when the grid reopens after a save.
    """
    clean_rofi_pid()
    selected_row = max(0, min(selected_row, max(0, count - 1)))
    command = [
        rofi_binary(),
        "-dmenu",
        "-i",
        "-no-history",
        "-no-custom",
        "-show-icons",
        "-format",
        "i",
        "-p",
        prompt,
        "-selected-row",
        str(selected_row),
        # Alt+S is rofi's default screenshot shortcut; free it before binding
        # it as our custom key, otherwise rofi refuses to start (exit 65).
        "-kb-screenshot",
        "",
        # Alt+B is rofi's "move word back"; free it so the previous-page key
        # does not make rofi show a configuration error instead of the grid.
        "-kb-move-word-back",
        "Control+Left",
        "-kb-custom-2",
        "Alt+s",
        "-kb-custom-3",
        "Alt+a",
        "-kb-custom-4",
        "Alt+q",
        "-kb-custom-5",
        "Alt+g",
    ]
    if has_prev:
        command += ["-kb-custom-6", "Alt+b"]
    if has_next:
        command += ["-kb-custom-1", "Alt+n"]
    enter_label = "apply" if on_enter == "apply" else "save"
    parts = [
        f"Enter — {enter_label}",
        "Alt+A — wallpaper",
        "Alt+S — save only",
    ]
    if has_prev:
        parts.append("Alt+B — prev page")
    if has_next:
        parts.append("Alt+N — next page")
    parts += ["Alt+G — go to page", "Alt+Q — quit", "Esc — search"]
    command += ["-mesg", "   ·   ".join(parts)]

    width, height, columns, lines, icon = grid_layout(count)
    grid_theme = GRID_THEME.replace("width: 1400px;", f"width: {width}px;")
    grid_theme = grid_theme.replace("height: 900px;", f"height: {height}px;")
    grid_theme = grid_theme.replace("columns: 4;", f"columns: {columns};")
    grid_theme = grid_theme.replace("lines: 3;", f"lines: {lines};")
    grid_theme = grid_theme.replace("size: 240px;", f"size: {icon}px;")
    command += themed_args(grid_theme)
    try:
        result = subprocess.run(
            command,
            input=entries,
            stdout=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        raise BooruError(f"cannot start rofi: {exc}") from exc
    debug(
        f"grid rofi rc={result.returncode} "
        f"has_next={has_next} has_prev={has_prev} count={count}"
    )
    if result.returncode == 10 and has_next:
        rofi_cooldown()
        return "next", None
    if result.returncode == 11:
        rofi_cooldown()
        return "save", grid_index(result, count)
    if result.returncode == 12:
        rofi_cooldown()
        return "apply", grid_index(result, count)
    if result.returncode == 13:
        rofi_cooldown()
        return "quit", None
    if result.returncode == 14:
        rofi_cooldown()
        return "page", None
    if result.returncode == 15 and has_prev:
        rofi_cooldown()
        return "prev", None
    if result.returncode != 0:
        rofi_cooldown()
        return "cancel", None
    index = grid_index(result, count)
    rofi_cooldown()
    return ("pick", index) if index is not None else ("cancel", None)


def ordered_choices(choices: list[str], current: str) -> list[str]:
    """Put the current value first so Enter keeps it instead of jumping to #1."""
    if current in choices:
        return [current] + [choice for choice in choices if choice != current]
    return list(choices)


def prompt_choice(prompt: str, choices: list[str], current: str) -> str | None:
    ordered = ordered_choices(choices, current)
    marked = [
        f"● {choice}" if choice == current else f"○ {choice}"
        for choice in ordered
    ]
    picked = rofi_menu(marked, prompt, lines_visible=len(marked))
    if picked is None:
        return None
    return picked[2:]


def page_picker(settings: Settings) -> int | None:
    """Jump straight to a page: pick one from the list or type its number."""
    current = settings.page
    last = max(99, current + 15)
    labels = [
        f"{'●' if number == current else '○'} Page {number}"
        for number in range(1, last + 1)
    ]
    picked = rofi_menu(labels, "Go to page", width=460, lines_visible=12)
    if picked is None:
        return None
    match = re.search(r"(\d+)", picked)
    if not match:
        return None
    return max(1, int(match.group(1)))


def prompt_int(prompt: str, current: int, minimum: int = 0) -> int | None:
    raw = rofi_text(prompt, str(current))
    if raw is None:
        return None
    try:
        value = int(raw)
    except ValueError:
        rofi_error(f"Not a number: {raw}")
        return None
    return max(minimum, value)


def prompt_size(current_w: int, current_h: int) -> tuple[int, int] | None:
    presets = [
        (0, 0),
        (1280, 720),
        (1920, 1080),
        (2560, 1440),
        (3840, 2160),
    ]
    labels = ["Any size" if (w, h) == (0, 0) else f"{w}×{h}" for w, h in presets]
    pairs = list(zip(labels, presets))
    current = (current_w, current_h)
    # Put the current size first: rofi selects the first line by default, and
    # Enter should keep the current value.
    if current in presets:
        index = presets.index(current)
        pairs = [pairs[index]] + [pair for i, pair in enumerate(pairs) if i != index]
    marked = [
        f"● {label}" if size == current else f"○ {label}"
        for label, size in pairs
    ]
    marked.append("○ Custom…")
    picked = rofi_menu(marked, "Minimum size", lines_visible=len(marked))
    if picked is None:
        return None
    value = picked[2:].strip()
    if value == "Custom…":
        raw = rofi_text("min width × min height", f"{current_w}×{current_h}")
        if raw is None:
            return None
        match = re.match(r"\s*(\d+)\s*[x×*]\s*(\d+)", raw)
        if not match:
            rofi_error("Use the form 1920×1080")
            return None
        return int(match.group(1)), int(match.group(2))
    for label, size in pairs:
        if value == label:
            return size
    return None


def prompt_tags(current: str) -> str | None:
    raw = rofi_text("Tags", current)
    if raw is None:
        return None
    return " ".join(raw.split())


def prompt_gelbooru(parser: configparser.ConfigParser) -> bool:
    api_key = rofi_text(
        "Gelbooru API key",
        parser.get("gelbooru", "api_key", fallback="").strip(),
    )
    if api_key is None:
        return False
    user_id = rofi_text(
        "Gelbooru user id",
        parser.get("gelbooru", "user_id", fallback="").strip(),
    )
    if user_id is None:
        return False
    if not parser.has_section("gelbooru"):
        parser.add_section("gelbooru")
    parser.set("gelbooru", "api_key", api_key.strip())
    parser.set("gelbooru", "user_id", user_id.strip())
    save_config(parser)
    notify("anime-wall", "Gelbooru credentials saved")
    return True


def search_prompt(
    current_tags: str,
    settings: Settings,
    notice: str = "",
    parser: configparser.ConfigParser | None = None,
) -> tuple[str, str | None]:
    """Free-text tag prompt — the main entry point.

    Tab (or Alt+T) asks the booru for tag completions starting with the
    unfinished word and shows how many posts each tag has. The rest of the
    line is preserved, so several tags can be added one by one.

    Returns ("search"|"filters"|"provider"|"quit"|"cancel", tags_or_None).
    """
    clean_rofi_pid()
    screen_w = screen_size()[0]
    width = min(900, max(720, int(screen_w * 0.36)))
    provider = PROVIDERS[settings.provider]
    size = (
        "any size"
        if not settings.min_width and not settings.min_height
        else f"≥{settings.min_width}×{settings.min_height}"
    )
    summary = (
        f"{provider['label']}  ·  {settings.rating}  ·  {size}"
        f"  ·  {settings.orientation}  ·  {settings.sort}"
    )
    hint = (
        "Enter: search    Tab: tag hints    Alt+F: filters    "
        "Alt+P: provider    Alt+Q: quit"
    )
    text = current_tags
    while True:
        theme = SEARCH_THEME.replace("width: 820px;", f"width: {width}px;")
        if notice:
            theme = theme.replace("height: 190px;", "height: 268px;")
        message = f"{notice}\n{summary}\n{hint}" if notice else f"{summary}\n{hint}"
        command = [
            rofi_binary(),
            "-dmenu",
            "-i",
            "-no-history",
            "-p",
            "Tag search",
            "-mesg",
            message,
            # rofi binds Alt+f to "move word forward"; keep only Ctrl+Right so
            # the plain Alt+f shortcut below works without needing Shift.
            "-kb-move-word-forward",
            "Control+Right",
            # Tab is normally "next element"; freeing it lets Tab open the tag
            # hint menu instead of moving the selection.
            "-kb-element-next",
            "",
            "-kb-custom-1",
            "Alt+f",
            "-kb-custom-2",
            "Alt+p",
            "-kb-custom-3",
            "Alt+q",
            # custom-4 returns 13, which this prompt reserves for "cancel";
            # Tab/Alt+T therefore use custom-5 (14) and custom-6 (15).
            "-kb-custom-5",
            "Tab",
            "-kb-custom-6",
            "Alt+t",
        ]
        if text:
            command += ["-filter", text]
        command += themed_args(theme)
        # dmenu expects list items on stdin; the actual query lives in -filter.
        # A single blank line keeps the custom-input row available.
        payload = "\n"
        try:
            result = subprocess.run(
                command,
                input=payload.encode(),
                stdout=subprocess.PIPE,
                check=False,
            )
        except OSError as exc:
            raise BooruError(f"cannot start rofi: {exc}") from exc
        if result.returncode in (14, 15):
            typed = result.stdout.decode("utf-8", "replace").rstrip("\r\n")
            rofi_cooldown()
            updated = None
            if parser is not None:
                updated = tag_suggestions(
                    settings, parser, tag_prefix(typed), typed
                )
            text = updated if updated is not None else typed
            notice = ""
            continue
        if result.returncode == 10:
            rofi_cooldown()
            return "filters", None
        if result.returncode == 11:
            rofi_cooldown()
            return "provider", None
        if result.returncode == 12:
            rofi_cooldown()
            return "quit", None
        if result.returncode != 0:
            rofi_cooldown()
            return "cancel", None
        tags = result.stdout.decode("utf-8", "replace").strip()
        rofi_cooldown()
        # Booru tags are lower-case; "Blue Sky" would otherwise silently match
        # nothing on Danbooru and friends.
        return "search", " ".join(tags.split()).lower()


def provider_picker(settings: Settings, state: dict | None = None) -> bool:
    """Quick Alt+P popup. Returns True when the provider changed."""
    order = list(PROVIDERS)
    current = PROVIDERS[settings.provider]["label"]
    labels = [PROVIDERS[key]["label"] for key in order]
    chosen = prompt_choice("Provider", labels, current)
    if chosen:
        for key in order:
            if PROVIDERS[key]["label"] == chosen:
                settings.provider = key
                settings.per_page = min(
                    settings.per_page, PROVIDERS[key]["max_limit"]
                )
                if state is not None:
                    settings.tags = state.get("last_tags", {}).get(key, "")
                return True
    return False


def settings_menu(
    settings: Settings, parser: configparser.ConfigParser, state: dict
) -> str | None:
    """Filter-only menu. No Search, Tags, or Quit entries — those are handled
    by the tag-search prompt."""
    provider = PROVIDERS[settings.provider]
    size = (
        "any"
        if not settings.min_width and not settings.min_height
        else f"{settings.min_width}×{settings.min_height}"
    )
    enter_label = (
        "apply as wallpaper"
        if settings.on_enter == "apply"
        else "save only"
    )
    entries = [
        f"   Provider: {provider['label']}",
        f"   Rating: {settings.rating}",
        f"   Min score: {settings.min_score}",
        f"   Min size: {size}",
        f"   Orientation: {settings.orientation}",
        f"   Sort: {settings.sort}",
        f"   Per page: {settings.per_page}",
        f"   Enter: {enter_label}",
        "   Gelbooru credentials…",
        "   Open downloads folder",
    ]
    picked = rofi_menu(
        entries,
        f"Anime Wall · {provider['label']} · filters",
        width=820,
        lines_visible=len(entries),
    )
    if picked is None:
        return None
    picked = picked.strip()

    if picked.startswith("Provider:"):
        order = list(PROVIDERS)
        current = provider["label"]
        labels = [PROVIDERS[key]["label"] for key in order]
        chosen = prompt_choice("Provider", labels, current)
        if chosen:
            for key in order:
                if PROVIDERS[key]["label"] == chosen:
                    settings.provider = key
                    settings.tags = state.get("last_tags", {}).get(key, "")
                    settings.per_page = min(
                        settings.per_page, PROVIDERS[key]["max_limit"]
                    )
    elif picked.startswith("Rating:"):
        chosen = prompt_choice("Rating", list(RATING_CHOICES), settings.rating)
        if chosen:
            settings.rating = chosen
    elif picked.startswith("Min score:"):
        value = prompt_int("Minimum score", settings.min_score)
        if value is not None:
            settings.min_score = value
    elif picked.startswith("Min size:"):
        value = prompt_size(settings.min_width, settings.min_height)
        if value is not None:
            settings.min_width, settings.min_height = value
    elif picked.startswith("Orientation:"):
        chosen = prompt_choice(
            "Orientation", list(ORIENTATION_CHOICES), settings.orientation
        )
        if chosen:
            settings.orientation = chosen
    elif picked.startswith("Sort:"):
        chosen = prompt_choice("Sort", list(SORT_CHOICES), settings.sort)
        if chosen:
            settings.sort = chosen
    elif picked.startswith("Per page:"):
        choices = ["12", "24", "48", "100"]
        chosen = prompt_choice("Results per page", choices, str(settings.per_page))
        if chosen:
            settings.per_page = int(chosen)
    elif picked.startswith("Enter:"):
        chosen = prompt_choice("Enter action", ["save", "apply"], settings.on_enter)
        if chosen:
            settings.on_enter = chosen
    elif picked.startswith("Gelbooru credentials"):
        if prompt_gelbooru(parser):
            settings.provider = "gelbooru"
    elif picked.startswith("Open downloads"):
        settings.download_dir.mkdir(parents=True, exist_ok=True)
        opener = shutil.which("xdg-open")
        if opener:
            subprocess.run([opener, str(settings.download_dir)], check=False)
    return "menu"


def spawn_download(post: Post, settings: Settings, apply: bool) -> bool:
    """Download in a detached worker so the rofi grid never blocks."""
    payload = json.dumps(
        {
            "post": asdict(post),
            "download_dir": str(settings.download_dir),
            "apply": apply,
        },
        ensure_ascii=False,
    )
    try:
        subprocess.Popen(
            [
                sys.executable,
                str(Path(__file__).resolve()),
                "--download-one",
                payload,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except (OSError, ValueError) as exc:
        rofi_error(f"Cannot start the download: {exc}")
        return False
    action = "Applying" if apply else "Saving"
    notify("anime-wall", f"{action} #{post.id}…", 1600)
    return True


def download_one(payload: str) -> int:
    """Worker entry point: save one post and optionally apply it."""
    try:
        data = json.loads(payload)
        post = Post(**data["post"])
        root = Path(data["download_dir"]).expanduser()
        folder = provider_folder(root, post.provider)
        target = download(post, folder)
    except (ValueError, KeyError, TypeError, OSError) as exc:
        notify("anime-wall", f"Download failed: {exc}", 6000)
        return 1
    except BooruError as exc:
        notify("anime-wall", f"Could not download: {exc}", 6000)
        return 1

    if data.get("apply"):
        applied = archive_wallpaper(target)
        try:
            apply_wallpaper(applied)
        except BooruError as exc:
            notify("anime-wall", f"Saved, but wallpaper was not applied: {exc}", 6000)
            return 1
        notify("Wallpaper applied", f"{post.provider} #{post.id}\n{applied}", 4000)
    else:
        tags = post.tags.split()[:4]
        body = f"{post.provider} #{post.id} · {target.name}\n{target.parent}"
        if tags:
            body = f"{body}\n{' '.join(tags)}"
        notify("Saved", body, 4000)
    return 0


def results_loop(
    settings: Settings, parser: configparser.ConfigParser, state: dict
) -> str:
    """Show results for the current page.

    Returns "menu" when the user wants to change filters, "next" when the
    page counter should advance, and "quit" to leave the browser.
    """
    while True:
        debug(f"fetch page={settings.page} tags={settings.tags!r}")
        try:
            posts = fetch_posts(settings, parser)
        except BooruError as exc:
            debug(f"fetch failed: {exc}")
            rofi_error(str(exc))
            state["notice"] = f"Search failed: {exc}"
            return "menu"

        if not posts and settings.page > 1:
            # Going past the last page (or typing a page number far beyond the
            # end) should return to the last page that actually had results,
            # not walk back one empty page at a time.
            fallback = max(1, min(settings.page - 1, int(
                state.get("last_good_page") or 1
            )))
            notify(
                "anime-wall",
                f"No results on page {settings.page} — back to page {fallback}",
                2600,
            )
            settings.page = fallback
            continue

        if not posts:
            rofi_error(
                "No results. Remove some tags, lower the score/size filter, "
                "or choose another rating."
            )
            state["notice"] = (
                f"No results for “{settings.tags or 'all'}” — "
                "change tags or press Alt+F"
            )
            return "menu"

        previews = fetch_previews(posts, settings.preview_workers)
        state["last_good_page"] = settings.page
        # Count the raw API page: local score/size filters may hide items, but
        # the next page still exists when the server returned a full page.
        has_next = cached_raw_count(settings) >= min(
            settings.per_page, PROVIDERS[settings.provider]["max_limit"]
        )
        debug(f"page={settings.page} posts={len(posts)} has_next={has_next}")
        saved_ids: set[int] = set()
        selected_row = 0

        while True:
            page_suffix = f" · page {settings.page}" if settings.page > 1 else ""
            prompt = (
                f"{PROVIDERS[settings.provider]['label']} · "
                f"{settings.tags or 'all'}{page_suffix}"
            )
            refresh_previews(posts, previews)
            entries = build_entries(
                posts, previews, settings.download_dir, saved_ids
            )
            action, index = run_grid(
                entries,
                prompt,
                len(posts),
                has_next,
                settings.on_enter,
                selected_row,
                has_prev=settings.page > 1,
            )
            debug(f"grid action={action} index={index} page={settings.page}")
            if action == "next":
                settings.page += 1
                return "next"
            if action == "prev":
                if settings.page > 1:
                    settings.page -= 1
                return "next"
            if action == "page":
                chosen = page_picker(settings)
                debug(f"page picker chose={chosen} current={settings.page}")
                if chosen is not None and chosen != settings.page:
                    settings.page = chosen
                    return "next"
                continue
            if action == "quit":
                return "quit"
            if action == "cancel" or index is None:
                return "menu"

            selected_row = index
            post = posts[index]
            if action == "save":
                apply = False
            elif action == "apply":
                apply = True
            else:
                apply = settings.on_enter == "apply"
            if spawn_download(post, settings, apply):
                saved_ids.add(post.id)
            time.sleep(0.25)  # prevent a double-click from hitting the new grid


def settings_to_args(settings: Settings) -> list[str]:
    return [
        "--provider",
        settings.provider,
        "--tags",
        settings.tags,
        "--rating",
        settings.rating,
        "--min-score",
        str(settings.min_score),
        "--min-width",
        str(settings.min_width),
        "--min-height",
        str(settings.min_height),
        "--orientation",
        settings.orientation,
        "--sort",
        settings.sort,
        "--limit",
        str(settings.per_page),
        "--page",
        str(settings.page),
    ]


def maybe_prefetch(
    settings: Settings,
    parser: configparser.ConfigParser,
    config_file: Path | None = None,
) -> None:
    """Warm the API and thumbnail caches in a detached process.

    The menu itself never waits for the network: by the time the user presses
    Search, the results and most previews are usually already on disk.
    """
    key = api_cache_key(settings)
    cached = read_api_cache(key)
    if cached is not None and time.time() - cached[1] < 120:
        return

    marker = cache_dir() / "prefetch.json"
    now = time.time()
    try:
        previous = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        previous = {}
    if (
        previous.get("key") == key
        and isinstance(previous.get("ts"), (int, float))
        and now - float(previous["ts"]) < 45
    ):
        return
    try:
        marker.write_text(json.dumps({"key": key, "ts": now}), encoding="utf-8")
    except OSError:
        pass

    args = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--prefetch",
    ]
    if config_file is not None:
        args += ["--config", str(config_file)]
    args += settings_to_args(settings)
    try:
        subprocess.Popen(
            args,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except (OSError, ValueError):
        pass


def ui(
    settings: Settings,
    parser: configparser.ConfigParser,
    state: dict,
    config_file: Path | None = None,
) -> int:
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        raise BooruError("no graphical session (DISPLAY is not set)")

    lock_path = cache_dir() / "ui.lock"
    lock_handle = lock_path.open("w")
    try:
        fcntl.flock(lock_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        notify("anime-wall", "Anime Wall is already open", 2000)
        return 0

    if not settings.tags:
        settings.tags = state.get("last_tags", {}).get(settings.provider, "")

    last_prefetch_key: str | None = None
    notice = ""
    while True:
        action, tags = search_prompt(
            settings.tags, settings, notice, parser
        )
        debug(f"search action={action} tags={tags!r}")
        notice = ""
        if action in ("quit", "cancel"):
            return 0
        if action == "filters":
            while True:
                act = settings_menu(settings, parser, state)
                if act is None:
                    break  # back to tag search
                persist_settings(settings, parser)
            state.pop("last_good_page", None)
            continue
        if action == "provider":
            if provider_picker(settings, state):
                persist_settings(settings, parser)
                state.pop("last_good_page", None)
            continue
        # action == "search"
        settings.tags = tags
        settings.page = 1
        state.pop("last_good_page", None)
        settings.clamp()
        state.setdefault("last_tags", {})[settings.provider] = settings.tags
        state["last_provider"] = settings.provider
        save_state(state)

        key = api_cache_key(settings)
        if key != last_prefetch_key:
            maybe_prefetch(settings, parser, config_file)
            last_prefetch_key = key

        while True:
            where = results_loop(settings, parser, state)
            if where == "quit":
                return 0
            if where != "next":
                break
        notice = state.pop("notice", "")


def prefetch_mode(settings: Settings, parser: configparser.ConfigParser) -> int:
    """Background worker: fetch the current page and warm all thumbnails."""
    try:
        posts = fetch_posts(settings, parser, use_cache=False, quiet=True)
    except BooruError:
        return 1
    if posts:
        fetch_previews(
            posts,
            settings.preview_workers,
            budget=30,
            spawn=False,
        )
    return 0


def prefetch_previews(payload: str) -> int:
    """Background worker: fill missing thumbnails for a list of posts."""
    try:
        items = json.loads(payload)
        posts = [Post(**item) for item in items]
    except (ValueError, TypeError, KeyError):
        return 1
    if posts:
        fetch_previews(posts, 16, budget=30, spawn=False)
    return 0


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="anime-wall",
        description="Browse and download anime art from boorus.",
    )
    parser.add_argument("-p", "--provider", choices=sorted(PROVIDERS), help="booru to query")
    parser.add_argument("-t", "--tags", help="space separated tags")
    parser.add_argument("-r", "--rating", choices=RATING_CHOICES)
    parser.add_argument("--min-score", type=int)
    parser.add_argument("--min-width", type=int)
    parser.add_argument("--min-height", type=int)
    parser.add_argument("-o", "--orientation", choices=ORIENTATION_CHOICES)
    parser.add_argument("-s", "--sort", choices=SORT_CHOICES)
    parser.add_argument("-n", "--limit", type=int, help="results per page")
    parser.add_argument("--page", type=int, default=1)
    parser.add_argument("--download", type=int, metavar="N", help="download the first N results")
    parser.add_argument("--download-dir", help="override the download folder")
    parser.add_argument("--print", action="store_true", dest="print_json", help="print results as JSON")
    parser.add_argument("--config", help="use an alternate config file")
    parser.add_argument("--prefetch", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--prefetch-previews", metavar="JSON", help=argparse.SUPPRESS)
    parser.add_argument("--download-one", metavar="JSON", help=argparse.SUPPRESS)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    path = Path(args.config).expanduser() if args.config else config_path()
    try:
        parser = load_config(path)
    except BooruError as exc:
        print(f"anime-wall: {exc}", file=sys.stderr)
        return 1

    settings = Settings.from_config(parser)
    if args.provider:
        settings.provider = args.provider
    if args.tags is not None:
        settings.tags = " ".join(args.tags.split())
    if args.rating:
        settings.rating = args.rating
    if args.min_score is not None:
        settings.min_score = args.min_score
    if args.min_width is not None:
        settings.min_width = args.min_width
    if args.min_height is not None:
        settings.min_height = args.min_height
    if args.orientation:
        settings.orientation = args.orientation
    if args.sort:
        settings.sort = args.sort
    if args.limit:
        settings.per_page = args.limit
    if args.page:
        settings.page = args.page
    if args.download_dir:
        settings.download_dir = Path(args.download_dir).expanduser()
    settings.clamp()

    if args.download_one:
        return download_one(args.download_one)
    if args.prefetch_previews:
        return prefetch_previews(args.prefetch_previews)
    if args.prefetch:
        return prefetch_mode(settings, parser)

    if not (args.print_json or args.download is not None):
        try:
            return ui(settings, parser, load_state(), path)
        except BooruError as exc:
            print(f"anime-wall: {exc}", file=sys.stderr)
            return 1

    try:
        posts = fetch_posts(settings, parser)
    except BooruError as exc:
        print(f"anime-wall: {exc}", file=sys.stderr)
        return 1

    if args.print_json:
        payload = [
            {
                "provider": post.provider,
                "id": post.id,
                "page": post.page_url,
                "file_url": post.file_url,
                "preview_url": post.preview_url,
                "width": post.width,
                "height": post.height,
                "score": post.score,
                "rating": post.normalized_rating(),
                "tags": post.tags,
                "file_size": post.file_size,
            }
            for post in posts
        ]
        json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
        return 0

    count = min(max(0, args.download or 0), len(posts))
    if count == 0:
        print("anime-wall: nothing matched", file=sys.stderr)
        return 1
    for post in posts[:count]:
        try:
            target = download(
                post, provider_folder(settings.download_dir, post.provider)
            )
        except BooruError as exc:
            print(f"anime-wall: {post.id}: {exc}", file=sys.stderr)
            return 1
        print(target)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
    except Exception as exc:  # keep the UI from dying with an invisible traceback
        print(f"anime-wall: {exc}", file=sys.stderr)
        notify("anime-wall", f"Error: {exc}", 6000)
        raise SystemExit(1)
