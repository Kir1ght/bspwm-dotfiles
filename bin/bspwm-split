#!/usr/bin/env bash
# Niri-style split placement for bspwm (keyboard-only workflow).
#
# bspwm has no drag-to-split: dragging a tiled window over another one swaps
# them. This helper gives the split result without touching the mouse:
#
#   1. mark the window you want to move        (Super+Alt+M)
#   2. focus the window that should be split  (usual focus keys)
#   3. press the half of the target            (Super+Alt+H/J/K/L)
#
# The marked window is placed immediately, so there is no preview to confirm
# and no extra key to press. Marking another window drops the previous mark.
#
# Super+Alt+C cancels a preselection left over from the mouse workflow or a
# manual `bspc node -p`; the keyboard flow never leaves one behind.
#
# The mouse/touchpad equivalent is bspwm-drag-split (Super+Alt+click/drag).

set -u

BSPC=${BSPC:-bspc}

say() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a bspwm-split "${1:-bspwm-split}" "${2:-}" -t 1400 >/dev/null 2>&1 || true
    fi
}

die() {
    say "$1" "${2:-}"
    printf '%s\n' "$1" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: bspwm-split COMMAND

Commands:
  mark                 mark or unmark the focused window
  left|right|up|down   place the marked window into that half of the focused window
  apply                apply a pending preselection, if any (advanced)
  cancel               cancel a pending preselection
  status               show the current mark and preselection

Default keys:
  Super+Alt+M          mark/unmark the window to move
  Super+Alt+H/J/K/L    place it into the left/down/up/right half of the target
  Super+Alt+C          cancel a pending preselection

Mark the window you want to move, focus the target window, then press a
direction. The marked window is placed immediately: there is no preview to
confirm. Only tiled and pseudo-tiled targets can be split (a floating marked
window is turned into a normal tile when it is placed). Fullscreen windows
must leave fullscreen first.
EOF
}

state_of() {
    "$BSPC" query -T -n "$1" 2>/dev/null \
        | sed -n 's/.*"state":"\([^"]*\)".*/\1/p' | head -n1
}

layout_of() {
    "$BSPC" query -T -d 2>/dev/null \
        | grep -o '"layout":"[^"]*"' | head -n1 | cut -d'"' -f4
}

is_tiled() {
    case "$(state_of "$1")" in
        tiled|pseudo_tiled) return 0 ;;
    esac
    return 1
}

require_tiled() {
    is_tiled "$1" || die "Focus a tiled window" "Floating and fullscreen windows cannot be split"
}

clear_marks_except() {
    local m
    for m in $("$BSPC" query -N -n .marked 2>/dev/null); do
        [ "$m" = "$1" ] || "$BSPC" node "$m" -g marked=off >/dev/null 2>&1 || true
    done
}

command -v "$BSPC" >/dev/null 2>&1 || die "bspc not found"

case "${1:-}" in
    mark)
        focused=$("$BSPC" query -N -n focused) || die "No focused window"
        [ "$(state_of "$focused")" = "fullscreen" ] \
            && die "Leave fullscreen first" "A fullscreen window cannot be marked"

        # Toggle on the focused window, but never keep a second mark around.
        if "$BSPC" query -N -n .marked 2>/dev/null | grep -qx "$focused"; then
            "$BSPC" node "$focused" -g marked=off || die "Could not toggle the mark"
            say "Mark removed" "Nothing will be moved"
        else
            clear_marks_except "$focused"
            "$BSPC" node "$focused" -g marked || die "Could not toggle the mark"
            say "Window marked" "Now focus the target window"
        fi
        ;;
    left|right|up|down)
        case "$1" in
            left)  dir=west ;;
            right) dir=east ;;
            up)    dir=north ;;
            down)  dir=south ;;
        esac
        focused=$("$BSPC" query -N -n focused) || die "No focused window"
        marked=$("$BSPC" query -N -n .marked 2>/dev/null | head -n1)

        # Refuse before touching the tree: a half with nothing to place would
        # just leave an empty preview and look like a broken layout.
        [[ -n "$marked" ]] || die "No marked window" "Press Super+Alt+M first"
        [[ "$marked" != "$focused" ]] \
            || die "The marked window is focused" "Focus the target window first"
        require_tiled "$focused"

        # A floating/pseudo-tiled source would keep its old geometry.
        "$BSPC" node "$marked" -t tiled >/dev/null 2>&1 || true
        if "$BSPC" node "$focused" -p "$dir" >/dev/null 2>&1 \
           && "$BSPC" node "$marked" -n "$focused" >/dev/null 2>&1; then
            "$BSPC" node "$marked" -g marked=off >/dev/null 2>&1 || true
            if [ "$(layout_of)" = "monocle" ]; then
                say "Window placed" "Leave monocle to see the split"
            else
                say "Window placed" "Split into the $1 half"
            fi
        else
            "$BSPC" node "$focused" -p cancel >/dev/null 2>&1 || true
            die "Could not place the window" "Try another half"
        fi
        ;;
    apply)
        focused=$("$BSPC" query -N -n focused) || die "No focused window"
        marked=$("$BSPC" query -N -n .marked | head -n1)

        # `apply` is only for a preselection set manually or by the mouse
        # preview. Never leave it behind on an error: the target would stay
        # shrunk to the half and look like a broken layout.
        cancel_presel() { "$BSPC" node "$focused" -p cancel >/dev/null 2>&1 || true; }

        [[ -n "$marked" ]] || { cancel_presel; die "No marked window" "Press Super+Alt+M first"; }
        [[ "$marked" != "$focused" ]] \
            || { cancel_presel; die "The marked window is focused" "Focus the target window first"; }
        if ! is_tiled "$focused"; then
            cancel_presel
            die "Focus a tiled window" "Floating and fullscreen windows cannot be split"
        fi

        if "$BSPC" query -T -n "$focused" | grep -q '"presel":null'; then
            die "Target has no preselection" "Nothing to apply"
        fi

        # A floating/pseudo-tiled source would keep its old geometry.
        "$BSPC" node "$marked" -t tiled >/dev/null 2>&1 || true
        if ! "$BSPC" node "$marked" -n "$focused"; then
            "$BSPC" node "$focused" -p cancel >/dev/null 2>&1 || true
            die "Could not move the marked window"
        fi
        "$BSPC" node "$marked" -g marked=off >/dev/null 2>&1 || true
        if [ "$(layout_of)" = "monocle" ]; then
            say "Window inserted" "Leave monocle to see the split"
        else
            say "Window inserted" "Into the selected half"
        fi
        ;;
    cancel)
        "$BSPC" node -p cancel || die "Could not cancel the preselection"
        say "Preselection cancelled"
        ;;
    status)
        focused=$("$BSPC" query -N -n focused 2>/dev/null || true)
        marked=$("$BSPC" query -N -n .marked 2>/dev/null | tr '\n' ' ' || true)
        printf 'focused: %s' "${focused:-none}"
        [ -n "$focused" ] && printf ' (%s)' "$(state_of "$focused")"
        printf '\n'
        printf 'marked:  %s\n' "${marked:-none}"
        if [[ -n "$focused" ]]; then
            "$BSPC" query -T -n focused 2>/dev/null | grep -o '"presel":[^,}]*' || true
        fi
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
