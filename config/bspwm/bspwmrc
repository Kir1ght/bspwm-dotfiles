#!/bin/sh

# Keep the NVIDIA dGPU asleep: use the AMD iGPU for VA-API/OpenCL and Firefox DRM
export PATH="$HOME/.local/bin:$PATH"

export LIBVA_DRIVER_NAME=radeonsi
export MOZ_DRM_DEVICE=/dev/dri/renderD129
export SAL_DISABLE_OPENCL=1

safe_exec="$HOME/.local/bin/desktop-no-fds"
bspc() { timeout -k 1 1 bspc "$@"; }
running() { pgrep -u "$(id -u)" -x "$1" >/dev/null; }
background() { "$safe_exec" "$@" >/dev/null 2>&1 & }

running sxhkd || background sxhkd

# A previous session may have left the panel DPMS-off; light it up again so a
# fresh X session never starts on a black screen.
command -v screen-wake >/dev/null 2>&1 && timeout -k 1 4 screen-wake >/dev/null 2>&1

# Multiple monitor support
# The HDMI port is wired to the NVIDIA GPU: attach its outputs as a PRIME
# display-offload sink first, otherwise xrandr (and dual_monitors.sh) cannot
# see them at all. Silent no-op while the dGPU is disabled in Xorg.
command -v hdmi-present >/dev/null 2>&1 && hdmi-present setup >/dev/null 2>&1
sh "$HOME/.config/bspwm/dual_monitors.sh"

# Palette generated from the current wallpaper (falls back to Dracula)
[ -f "$HOME/.config/bspwm/colors.sh" ] && . "$HOME/.config/bspwm/colors.sh"

# Window borders (Auto-Generate)
bspc config focus_follows_pointer true
bspc config focused_border_color "${FOCUSED_BORDER:-#bd93f9}"
bspc config normal_border_color "${NORMAL_BORDER:-#44475a}"
bspc config border_width 2
bspc config borderless_monocle true

bspc config active_border_color "${ACTIVE_BORDER:-#ff79c6}"
bspc config presel_feedback_color "${PRESEL_FEEDBACK:-#6272a4}"

# fix pointer
timeout 2 xsetroot -cursor_name left_ptr

# gaps
bspc config gapless_monocle false
bspc config window_gap 8

# Native bspwm pointer actions (hold Super): move floating windows / swap
# tiled ones with the left button, resize with the middle and right buttons.
# Tiled resize changes the border shared with a neighbour; a window that fills
# the monitor has nothing to resize against — make it pseudo-tiled to resize
# it freely. Niri-style split placement lives on Super + Alt + left button.
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action3 resize_corner

# rules
bspc rule -a feh state=floating

# start resources
timeout 2 xrdb merge "$HOME/.Xresources"

# Keyboard layout: configure here too, because ly starts bspwm directly and
# never runs ~/.xinitrc. Re-applying unconditionally would switch the user back
# to the first layout on every bspwmrc reload, so apply it only when the loaded
# keymap is actually wrong.
#
# Check the real keymap, not a flag in a root property. Xorg rebuilds the
# keymap whenever an input device is hotplugged (this laptop's wireless dongle
# exposes keyboard devices and reconnects on its own) and re-applies
# /etc/X11/xorg.conf.d/00-keyboard.conf. If that file lists only "us", the
# Russian group vanishes mid-session while a remembered flag would survive.
# ~/.local/bin/xkb-layout-guard covers the hotplug case; the permanent cure is
# `localectl set-x11-keymap us,ru pc105 "" grp:alt_shift_toggle`.
if command -v setxkbmap >/dev/null 2>&1; then
    kbd_query=$(LC_ALL=C timeout 2 setxkbmap -query 2>/dev/null)
    kbd_layout=$(printf '%s\n' "$kbd_query" | sed -n 's/^layout:[[:space:]]*//p')
    kbd_options=$(printf '%s\n' "$kbd_query" | sed -n 's/^options:[[:space:]]*//p')
    if [ "$kbd_layout" != "us,ru" ] ||
        ! printf '%s' "$kbd_options" | grep -q 'grp:alt_shift_toggle'; then
        timeout 2 setxkbmap -layout us,ru -option grp:alt_shift_toggle || true
    fi
fi

# Restore the layout if an input hotplug resets it mid-session.
background "$HOME/.local/bin/xkb-layout-guard"

# Language change notifications (listens to XKB group changes)
# OFF: commented out — uncomment to re-enable (requires xkb-switch)
#pgrep -f lang-notify.sh > /dev/null || ~/bin/lang-notify.sh &

# Wallpaper: restore the last image. Run it through sh so an old ~/.fehbg
# without the execute bit still works. ~/.current_wallpaper is the stable
# symlink to the source image; it is the fallback if ~/.fehbg is missing.
# A fresh install has no ~/.fehbg yet, so it starts with the bundled default.
DESKTOP_WALL_DIR="$HOME/Images/Wallpaper_desktop"
DEFAULT_WALL="$DESKTOP_WALL_DIR/default.png"
if [ ! -f "$DEFAULT_WALL" ]; then
    DEFAULT_WALL=$(find "$DESKTOP_WALL_DIR" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        2>/dev/null | sort | head -n1)
fi
if [ -f "$HOME/.fehbg" ] && timeout -k 1 5 sh "$HOME/.fehbg" 2>/dev/null; then
    :
elif [ -f "$HOME/.current_wallpaper" ]; then
    timeout -k 1 5 feh --no-fehbg --bg-fill "$HOME/.current_wallpaper"
elif [ -f "$DEFAULT_WALL" ]; then
    timeout -k 1 5 feh --bg-fill "$DEFAULT_WALL"
fi

# Panel refresh rate: 60 Hz on battery, highest on AC. Event-driven through
# UPower, so nothing polls the hardware every few seconds.
background "$HOME/bin/refresh-auto" --monitor

# Run polybar
"$safe_exec" "$HOME/.config/polybar/launch.sh" --ensure

# launch notification daemon (once; bspwmrc also runs on reload)
running dunst || background dunst -config "$HOME/.config/bspwm/dunstrc"
background "$HOME/.config/theme/apply.py" --quiet --debounce 0

# launch battery tracker and redshift
background "$HOME/bin/battery-alert"
running redshift || background redshift

# start compositor
running picom || background picom --config "$HOME/.config/bspwm/picom_configurations/1.conf"

# == autostart ==
if command -v ksnip >/dev/null 2>&1 && ! running ksnip; then
    background ksnip
fi
if command -v throne >/dev/null 2>&1 && ! running throne; then
    background throne
fi

# launch clipboard manager daemon
if command -v greenclip >/dev/null 2>&1 && ! running greenclip; then
    background greenclip daemon
fi

# Activate the existing session-bus service, not the app or tray indicator.
if command -v kdeconnectd >/dev/null 2>&1 && command -v gdbus >/dev/null 2>&1; then
    background timeout 4 gdbus call --session --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.StartServiceByName org.kde.kdeconnect 0
fi

# Touchpad autoswitch: disable the pad (both of its XInput interfaces) while a
# mouse is connected. The daemon also owns the per-session Touchégg client:
# it stops it while a mouse is connected (gestures read the pad through
# libinput, so disabling the device in X is not enough) and starts it again
# when the mouse goes away. The `touchegg --daemon` system service is enabled
# by install.sh and is never touched.
background "$HOME/.local/bin/touchpad-when-mouse.sh"

# Run the cursor tracker detached: it loops forever and must not block bspwmrc.
background "$HOME/bin/caffeine.sh" --restore
background "$HOME/bin/cursor_tracker.sh"

# Swappy
bspc rule -a Swappy state=floating centered=on

# window rule
# bspc config focus_follows_pointer false

# fixer
# bspc config pointer_follows_focus false
